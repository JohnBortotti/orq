# --- schedules: systemd --user ----------------------------------------------

def systemctl(*a, check=True):
    return run(["systemctl", "--user", *a], check=check)


def orq_timezone():
    """Fuso a escrever nas unidades. NUNCA se omite: quando um agente pede
    "todo dia as 19h" ele quer dizer 19h DO USER, e nao tem como saber em que
    fuso a caixa esta. A regra vale mesmo com a maquina no fuso certo -- em
    31/08 a asimov estava em Etc/UTC e um `19:03` cru dispararia 16:03."""
    cfg = load_yaml(CONFIG, "config.yml") if CONFIG.exists() else {}
    tz = (cfg or {}).get("timezone")
    if tz:
        return tz
    r = run(["timedatectl", "show", "-p", "Timezone", "--value"], check=False)
    return r.stdout.strip() or "UTC"


def _tok(tok):
    """Campo de cron -> campo de calendario systemd."""
    if tok == "*":
        return "*"
    t = tok.replace("-", "..")
    if t.startswith("*/"):
        t = "0/" + t[2:]
    return ",".join(x.zfill(2) if x.isdigit() else x for x in t.split(","))


def _dow(tok):
    if tok == "*":
        return ""
    nomes = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    def um(x):
        return nomes[int(x)] if x.isdigit() and int(x) <= 7 else x
    partes = []
    for parte in tok.split(","):
        if "-" in parte:
            a, b = parte.split("-", 1)
            partes.append(f"{um(a)}..{um(b)}")
        else:
            partes.append(um(parte))
    return ",".join(partes) + " "


def cron_to_calendar(expr, tz):
    campos = expr.split()
    if len(campos) != 5:
        raise OrqError(
            f"cron precisa de 5 campos (min hora dia mes dia-da-semana), "
            f"veio {len(campos)}: '{expr}'"
        )
    m, h, dom, mon, dow = campos
    return (f"{_dow(dow)}*-{_tok(mon)}-{_tok(dom)} "
            f"{_tok(h)}:{_tok(m)}:00 {tz}")


def calendar_next(calendario):
    """`systemd-analyze calendar` e' o validador de graca: valida a expressao
    E imprime a proxima execucao, entao nao ha parser de cron escrito a mao
    pra confiar."""
    r = run(["systemd-analyze", "calendar", calendario], check=False)
    if r.returncode != 0:
        detalhe = (r.stderr or r.stdout or "").strip().splitlines()
        raise OrqError(f"calendario invalido '{calendario}': "
                       f"{detalhe[0] if detalhe else 'recusado pelo systemd'}")
    for linha in r.stdout.splitlines():
        if "Next elapse:" in linha:
            return linha.split("Next elapse:", 1)[1].strip()
    return "?"


def sched_units():
    """O que o SYSTEMD conhece, nao o que ha no disco."""
    r = systemctl("list-unit-files", f"{SCHED_PREFIX}*.timer",
                  "--no-legend", "--plain", check=False)
    nomes = []
    for linha in r.stdout.splitlines():
        campos = linha.split()
        if campos and campos[0].endswith(".timer"):
            nomes.append(campos[0][len(SCHED_PREFIX):-len(".timer")])
    return sorted(nomes)


def sched_meta(nome):
    """Metadados vem das linhas `# orq:` da propria unidade -- e' isto que faz
    a unidade se autodescrever e dispensa um espelho pra divergir."""
    r = systemctl("cat", f"{SCHED_PREFIX}{nome}.service", check=False)
    meta, execstart = {}, None
    for linha in r.stdout.splitlines():
        if linha.startswith("# orq:"):
            for par in linha[len("# orq:"):].strip().split("  "):
                if "=" in par:
                    k, v = par.split("=", 1)
                    meta[k.strip()] = v.strip()
        elif linha.startswith("ExecStart="):
            execstart = linha[len("ExecStart="):]
    meta["exec"] = execstart
    return meta


def cmd_up(args, quiet=False):
    ws = resolve_ws(ws_arg(args))
    cfg = workspace_config(ws)
    session = cfg.get("session") or ws
    if not session_exists(session):
        tmux("new-session", "-d", "-s", session, "-n", LEAD_WINDOW,
             "-c", str(lead_root(cfg)))
        # `set-option -t` e' alvo de PANE, entao `=<sessao>` sozinho nao resolve
        # ("no such session"). O `:` final o torna alvo de sessao, e o `=` segue
        # impedindo casar com uma sessao de nome parecido.
        for opt in (("status-left", "#[bold] #S #[default]| "),
                    ("status-left-length", "18"),
                    ("status-interval", "5")):
            tmux("set-option", "-t", f"={session}:", opt[0], opt[1])
        tmux("set-window-option", "-t", f"={session}:", "monitor-silence", "10",
             check=False)
        log_event(cmd="up", ws=ws, session=session, created=True, ok=True)
        if not quiet:
            print(f"sessao '{session}' criada")
    else:
        log_event(cmd="up", ws=ws, session=session, created=False, ok=True)
        if not quiet:
            print(f"sessao '{session}' ja existia")
    if not quiet:
        print(f"attach:  tmux -L {SOCKET} attach -t {session}")


def cmd_attach(args):
    ws = resolve_ws(ws_arg(args))
