    session = cfg.get("session") or ws
    if not session_exists(session):
        raise OrqError(f"sessao '{session}' nao existe — rode `orq up {ws}`")
    os.execvp("tmux", ["tmux", "-L", SOCKET, "attach", "-t", session])


def cmd_wt_new(args):
    ws = resolve_ws(ws_arg(args))
    cfg = workspace_config(ws)
    session = cfg.get("session") or ws
    repo, slug = split_target(args.target)
    src = repo_path(cfg, repo)
    dst = worktree_path(cfg, repo, slug)
    branch = args.branch

    # Detalhe #7: up implicito.
    if not session_exists(session):
        cmd_up(argparse.Namespace(ws=ws), quiet=True)

    if dst.exists():
        raise OrqError(f"worktree ja existe: {dst}")

    # Base fresca. `git fetch` NAO move a main local — so cortando de
    # origin/<default> a base e' fresca de verdade. Fetch que falha aborta.
    if not args.no_fetch:
        git(src, "fetch", "origin", "--prune")

    reused = branch_exists(src, branch)
    if reused:
        # Branch existente e' reusada e NUNCA rebaseada.
        base = branch
        git(src, "worktree", "add", str(dst), branch)
    else:
        base = args.base or default_remote_branch(src)
        git(src, "worktree", "add", str(dst), "-b", branch, base)
    base_sha = git(dst, "rev-parse", "HEAD").stdout.strip()

    ops = {"copied": [], "linked": []}
    if not args.no_files:
        ops = apply_file_ops(cfg, src, dst)
    if not args.no_hooks:
        run_post_create(cfg, dst)

    # Armadilha 1: `-d`. Sem isso a janela rouba o foco do humano.
    window = f"{repo}/{slug}"
    tmux("new-window", "-d", "-t", f"={session}", "-n", window, "-c", str(dst))

    def mutate(state):
        state.setdefault("worktrees", {})[window] = {
            "repo": repo, "slug": slug, "branch": branch,
            "path": str(dst), "base": base, "base_sha": base_sha,
            # descontado da checagem de sujeira: o orq criou, nao o usuario
            "orq_files": sorted(ops["copied"] + ops["linked"]),
            "created_at": datetime.now(timezone.utc).astimezone().isoformat(),
        }
    update_state(ws, mutate)

    log_event(cmd="wt new", ws=ws, wt=window, repo=repo, branch=branch,
              path=str(dst), base=base, base_sha=base_sha, reused_branch=reused,
              files=ops, ok=True)
    print(f"{window}  ->  {dst}")
    print(f"  branch {branch} {'(reusada, nao rebaseada)' if reused else f'de {base} @ {base_sha[:8]}'}")
    if ops["copied"] or ops["linked"]:
        print(f"  files: {len(ops['copied'])} copiados, {len(ops['linked'])} linkados")

    # `wt new` + `spawn` e' a sequencia mais comum do orq. A flag existia no
    # parser desde a Fase 1 e nunca era lida: aceitava e ignorava em silencio,
    # que e' pior que nao existir -- os stubs pelo menos recusam falando.
    if args.spawn:
        nome = args.as_name or slug.replace("/", "-")
        cmd_spawn(argparse.Namespace(
            name=nome, ws=ws, ws_pos=None, wt=window, provider=args.spawn,
            cmd_str=None, prompt=args.prompt, parent=None, split=False,
        ))


def cmd_wt_rm(args):
    ws = resolve_ws(ws_arg(args))
    cfg = workspace_config(ws)
    session = cfg.get("session") or ws
    repo, slug = split_target(args.target)
    window = f"{repo}/{slug}"
    src = repo_path(cfg, repo)
    dst = worktree_path(cfg, repo, slug)

    if not dst.exists():
        raise OrqError(f"worktree nao existe: {dst}")

    if not args.force:
        recusas = []
        meus = read_state(ws).get("worktrees", {}).get(window, {}).get("orq_files", [])
        sujos = dirty_entries(dst, meus)
        if sujos:
            amostra = ", ".join(sujos[:3]) + ("…" if len(sujos) > 3 else "")
            recusas.append(f"a arvore esta suja ({amostra})")
        branch = git(dst, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
        pendentes = unpushed_commits(dst, branch)
        if pendentes:
            recusas.append(f"{len(pendentes)} commit(s) fora do origin em '{branch}'")
        # "Agente vivo" = um provider rodando DENTRO do pane. Olha a arvore de
        # processos, nao o `pane_current_command`: este ultimo reporta o shell
        # pros panes nascidos de split-window, e escondia todo agente a partir
        # do segundo. Bash esquecido no prompt continua nao travando.
        conhecidos = set(providers_config())
        vivos = []
        for p in list_panes(session):
            if p["window"] != window:
                continue
            achados = [c for c in p["procs"] if c in conhecidos]
            if achados:
                vivos.append((achados[0], p["pane"]))
        if vivos:
            nomes = ", ".join(f"{c}@{pane}" for c, pane in vivos)
            recusas.append(f"agente vivo dentro ({nomes})")
        if recusas:
            log_event(cmd="wt rm", ws=ws, wt=window, ok=False, refused=recusas)
            raise OrqError(
                f"recusado: {'; '.join(recusas)}.\n"
                f"  use --force pra remover mesmo assim (a branch NUNCA e' apagada)"
            )

    # Os arquivos que o orq colocou sao untracked pro git, entao sem isto o
    # `git worktree remove` recusa SEMPRE que o workspace tem `files:` — a
    # checagem de sujeira ja os descontava e a remocao nao, o que travava o
    # comando por incoerencia. Symlink sai sempre (o alvo nao e' tocado);
    # copia so sai se estiver IDENTICA a origem, senao e' edicao do usuario e
    # vira recusa em vez de perda silenciosa.
    meus = read_state(ws).get("worktrees", {}).get(window, {}).get("orq_files", [])
    # DUAS passadas: classifica tudo, decide, so entao apaga. Numa passada so,
    # a recusa chegava depois de ja ter apagado os itens anteriores da lista.
    aptos, mexidos = [], []
    for rel in meus:
        alvo = dst / rel
        if alvo.is_symlink():
            aptos.append(rel)                    # o alvo do link nao e' tocado
        elif alvo.is_file():
            origem = src / rel
            igual = origem.is_file() and origem.read_bytes() == alvo.read_bytes()
            (aptos if (igual or args.force) else mexidos).append(rel)
        elif alvo.is_dir():
            aptos.append(rel)
    if mexidos:
        log_event(cmd="wt rm", ws=ws, wt=window, ok=False, modified=mexidos)
        raise OrqError(
            f"recusado: {', '.join(mexidos)} — o orq colocou esse(s) arquivo(s) "
            f"aqui, mas voce editou desde entao.\n"
            f"  salve o que interessa e rode de novo, ou use --force pra perder"
        )

    apagados = []
    for rel in aptos:
        alvo = dst / rel
        if alvo.is_symlink() or alvo.is_file():
            alvo.unlink()
        elif alvo.is_dir():
            shutil.rmtree(alvo)
        apagados.append(rel)

    # O git PRIMEIRO. Ao contrario, uma recusa do git deixava a janela morta e
    # o worktree de pe: perdiam-se os panes e nao se removia nada.
    try:
        git(src, "worktree", "remove", str(dst),
            *(["--force"] if args.force else []))
    except OrqError:
        # A remocao falhou DEPOIS de eu tirar os arquivos que o orq pos aqui.
        # Sem devolver, o worktree sobrevive mutilado -- sem .env e sem
        # node_modules a app nao sobe, e nada na tela explicaria por que.
        if apagados:
            apply_file_ops(cfg, src, dst)
        raise
    if window_exists(session, window):
        tmux("kill-window", "-t", f"={session}:{window}")

    def mutate(state):
        state.get("worktrees", {}).pop(window, None)
    update_state(ws, mutate)

    log_event(cmd="wt rm", ws=ws, wt=window, path=str(dst), forced=args.force,
              orq_files_removed=apagados, ok=True)
    print(f"{window} removido (branch preservada)")
    if apagados:
        print(f"  apagados (postos pelo orq): {', '.join(apagados)}")


def cmd_spawn(args):
    if not NAME_RE.match(args.name):
        raise OrqError(f"nome invalido: '{args.name}' (esperado {NAME_RE.pattern})")
    if args.cmd_str and args.prompt:
        raise OrqError("--prompt so faz sentido com provider, nao com --cmd")
    ws = resolve_ws(ws_arg(args))
    cfg = workspace_config(ws)
    session = cfg.get("session") or ws

    state = read_state(ws)
    if args.name in (state.get("agents") or {}):
        raise OrqError(f"'{args.name}' ja esta em uso neste workspace")

    criei_janela = False
    if args.wt:
        repo, slug = split_target(args.wt)
        window = f"{repo}/{slug}"
        meta = (state.get("worktrees") or {}).get(window)
        if not meta:
            raise OrqError(f"worktree '{window}' nao existe — rode `orq wt new` antes")
        if not window_exists(session, window):
            raise OrqError(f"a janela '{window}' nao esta viva — rode `orq resurrect`")
        path = meta["path"]
    else:
        # Sem --wt o agente e' de nivel de workspace: nasce no `root:`, na
        # janela _lead. A janela e' recriada se sumiu, porque `resurrect` so
        # cuida de worktree e a sessao pode ter perdido so esta.
        if not session_exists(session):
            raise OrqError(f"sessao '{session}' nao existe — rode `orq up {ws}`")
        window = LEAD_WINDOW
        path = str(lead_root(cfg))
        if not window_exists(session, window):
            tmux("new-window", "-d", "-t", f"={session}", "-n", window, "-c", path)
            criei_janela = True

    session_id = str(uuid.uuid4())
    if args.cmd_str:
        provider = None
        # `--cmd` roda literalmente, mas embrulhado: sem isso o pane FECHA
        # quando a ferramenta sai, e some antes de ser lido quando a saida e'
        # curta (git diff com less -F encerra sozinho se cabe numa tela).
        launch = f"{args.cmd_str}; exec $SHELL"
        binario = None
    else:
        provider = args.provider or cfg.get("provider") or "claude"
        base = provider_cmd(provider, session_id)
        launch = f"{base}; exec $SHELL"
        binario = base.split()[0]
        pcfg = providers_config().get(provider) or {}
        ready_when = pcfg.get("ready_when") if isinstance(pcfg, dict) else None
        blocked_when = pcfg.get("blocked_when") if isinstance(pcfg, dict) else None

    # Toma o pane que ja existe se a janela nao tem agente registrado e o pane
    # esta num shell parado — senao o primeiro agente desperdica meia tela com
    # um bash que ninguem pediu.
    panes = [p for p in list_panes(session) if p["window"] == window]
    registrados = {a["pane"] for a in (state.get("agents") or {}).values()}
    # Livre = shell parado de verdade. `command in SHELLS` sozinho nao basta:
    # pane com agente vivo tambem reporta shell quando nasceu de split-window,
    # e tomar esse pane colaria o launch por cima de um agente trabalhando.
    livres = [p for p in panes if p["pane"] not in registrados
              and p["command"] in SHELLS
              and all(c in SHELLS for c in p["procs"])]
    # Janela que o proprio spawn acabou de criar tem um pane so, novo e de
    # ninguem — nao precisa da heuristica de shell parado, e nao pode usa-la:
    # por ~50ms depois do `new-window` o tmux ainda reporta `tmux` como
    # pane_current_command, entao o pane nao casaria com SHELLS e o spawn
    # dividiria a janela deixando um bash orfao ao lado.
    tomar = (not args.split) and (
        criei_janela or (len(panes) == 1 and len(livres) == 1))

    if tomar:
        # Na janela recem-criada o unico pane e' o nosso e `livres` esta vazio
        # pela mesma corrida de pane_current_command — entao pega de `panes`.
        pane = (panes if criei_janela else livres)[0]["pane"]
        tmux("send-keys", "-t", pane, "-l", launch)
        tmux("send-keys", "-t", pane, "Enter")
    else:
        # Armadilha 1: `-d`. Sem isso o pane novo rouba o foco do humano.
        alvo = f"={session}:{window}"
        p = tmux("split-window", "-d", "-P", "-F", "#{pane_id}",
                 "-t", alvo, "-c", path, launch)
        pane = p.stdout.strip()

    parent = args.parent or caller_agent()

    def mutate(st):
        st.setdefault("agents", {})[args.name] = {
            "pane": pane, "wt": window if args.wt else None,
            "window": window, "provider": provider,
            "cmd": args.cmd_str, "session_id": session_id if provider else None,
            "parent": parent, "path": path,
            "created_at": datetime.now(timezone.utc).astimezone().isoformat(),
        }
    update_state(ws, mutate)
    log_event(cmd="spawn", ws=ws, wt=window if args.wt else None,
              window=window, name=args.name, pane=pane,
              provider=provider, cmd_str=args.cmd_str,
              session_id=session_id if provider else None, parent=parent,
              took_existing=tomar, ok=True)

    print(f"{args.name}  {pane}  em {window}"
          f"{f'  ({provider})' if provider else f'  ({args.cmd_str})'}"
          f"{'  [tomou o pane existente]' if tomar else ''}")
    if parent:
        print(f"  pai: {parent}")

    if args.prompt:
        pronto, motivo = wait_for_ready(pane, binario, ready_when, blocked_when)
        if not pronto:
            log_event(cmd="spawn", ws=ws, name=args.name, pane=pane,
                      prompt_sent=False, reason=motivo, ok=False)
            raise OrqError(
                f"'{args.name}' subiu, mas o PROMPT NAO FOI ENVIADO: {motivo}.\n"
                f"  o pane esta vivo — resolva na tela e mande com:\n"
                f"    orq send {args.name} \"...\""
            )
        paste_into(pane, args.prompt)
        log_event(cmd="send", ws=ws, name=args.name, pane=pane,
                  chars=len(args.prompt), origem="spawn --prompt", ok=True)
        print(f"  prompt enviado ({len(args.prompt)} chars)")


def cmd_send(args):
    ws, reg = find_agent(args.name)
    # Armadilha 6(b): NAO checa se o input esta livre. A caixa do Claude Code
    # mostra sugestao contextual indistinguivel de texto digitado, e ele
    # enfileira sozinho o que chega durante a geracao. Cola e manda.
    paste_into(reg["pane"], args.text, enter=not args.no_enter)

    # Input novo significa que ele nao esta mais "done". Sem isto o registro
    # mentiria no follow-up: o pai manda mais trabalho e o `ls` continua
    # mostrando terminado. Quando os hooks chegarem eles sobrescrevem com
    # `working`; ate la, limpar e' melhor que afirmar o que nao e' verdade.
    if reg.get("status"):
        def mutate(st):
            a = (st.get("agents") or {}).get(args.name)
            if a is not None:
                a.pop("status", None); a.pop("status_at", None)
        update_state(ws, mutate)

    log_event(cmd="send", ws=ws, name=args.name, pane=reg["pane"],
              chars=len(args.text), enter=not args.no_enter, ok=True)


def cmd_keys(args):
    ws, reg = find_agent(args.name)
    tmux("send-keys", "-t", reg["pane"], *args.keys)
    log_event(cmd="keys", ws=ws, name=args.name, pane=reg["pane"],
              keys=args.keys, ok=True)


def cmd_done(args):
    """Fecha o turno: grava o status no registro e avisa o pai.

    NAO mata o pane. `done` quer dizer "terminei meu turno", nao "o trabalho
    acabou" -- o trabalho acaba no merge e a faxina e' do `wt rm`. O pane fica
    de pe com a conversa na tela, pronto pra follow-up sem custo de --resume.

    Nao existe `orq wait` do outro lado: o pai que encerrou o turno ja esta
    ocioso esperando input, e este send chega como mensagem nova e o acorda.
    """
    nome = caller_agent()
    if not nome:
        raise OrqError(
            "`done` so vale de dentro do pane de um agente registrado — "
            "$TMUX_PANE nao casa com nenhum agente do registro"
        )
    ws, reg = find_agent(nome)

    set_status(ws, nome, "done")

    destino = args.to or reg.get("parent")
    msg = f"[{nome}] done" + (f": {args.msg}" if args.msg else "")

    # O status e' gravado antes de tentar entregar, e nao e' desfeito se a
    # entrega falhar: quem terminou terminou, exista ou nao destinatario.
    if not destino:
        log_event(cmd="done", ws=ws, name=nome, pane=reg["pane"], to=None,
                  msg=args.msg, delivered=False, reason="sem pai", ok=True)
        print(f"{nome}: status done gravado")
        print("  ninguem avisado — sem pai no registro e sem --to")
        return

    try:
        _, reg_pai = find_agent(destino)
    except OrqError as e:
        log_event(cmd="done", ws=ws, name=nome, pane=reg["pane"], to=destino,
                  msg=args.msg, delivered=False, reason=str(e), ok=False)
        raise OrqError(f"status done gravado, mas '{destino}' nao foi avisado: {e}")

    paste_into(reg_pai["pane"], msg)
    log_event(cmd="done", ws=ws, name=nome, pane=reg["pane"], to=destino,
              to_pane=reg_pai["pane"], msg=args.msg, delivered=True, ok=True)
    print(f"{nome}: status done gravado; avisei '{destino}' ({reg_pai['pane']})")


def cmd_status_hook(args):
    """Chamado PELO agente, via hook do provider. Le o payload no stdin e
    traduz o evento em status.

    Silencioso por contrato, e engole toda excecao: hook que fala polui a tela
    do agente e hook que quebra atrapalha o turno dele. Nao escreve no
    log.jsonl -- o log e' de comandos que alguem emitiu, e o estado vive no
    registro, que ja sai por `orq ls --json`.
    """
    try:
        payload = json.loads(sys.stdin.read() or "{}")
        status = HOOK_STATUS.get(payload.get("hook_event_name"))
        if not status:
            return
        ws, nome = agent_by(payload.get("session_id"),
                            os.environ.get("TMUX_PANE"))
        if ws:
            set_status(ws, nome, status)
    except Exception:
        return


def cmd_read(args):
    _, reg = find_agent(args.name)
    # Armadilha 2: capture-pane logo depois de escrever devolve o frame
    # anterior. Le duas vezes; a segunda e' a boa.
    tmux("capture-pane", "-p", "-t", reg["pane"], "-S", f"-{args.lines}")
    out = tmux("capture-pane", "-p", "-t", reg["pane"], "-S", f"-{args.lines}")
    print(out.stdout.rstrip())


def cmd_kill(args):
    ws, reg = find_agent(args.name)
    tmux("kill-pane", "-t", reg["pane"], check=False)

    def mutate(st):
        st.get("agents", {}).pop(args.name, None)
    update_state(ws, mutate)
    log_event(cmd="kill", ws=ws, name=args.name, pane=reg["pane"], ok=True)
    print(f"{args.name} ({reg['pane']}) morto")


def cmd_resurrect(args):
    """Worktree vivo no disco que perdeu a janela — o caso classico e' reboot,
    que leva o servidor tmux inteiro e nao encosta em nada do git.

    NAO ressuscita agente: a janela volta com shell puro. Quem quer agente
    chama `spawn`, porque decidir quais agentes valia subir de novo, e com que
    prompt, e' julgamento — e julgamento e' trabalho de agente lendo o log,
    nao de comando.
    """
    _ws = ws_arg(args)
    workspaces = [_ws] if _ws else sorted(
        p.stem for p in WORKSPACES.glob("*.yml")) if WORKSPACES.exists() else []
    plano, orfaos = [], []
    for ws in workspaces:
        try:
            cfg = workspace_config(ws)
        except OrqError:
            continue
        session = cfg.get("session") or ws
        state = read_state(ws)
        root = expand(cfg.get("worktrees") or "~/wt")

        # 1. o registro
        cands = {w: dict(m, origem="registro")
                 for w, m in (state.get("worktrees") or {}).items()}

        # 2. o git, que pega o que o registro perdeu
        for repo, rp in (cfg.get("repos") or {}).items():
            try:
                conhecidos = git_worktrees(expand(rp))
            except OrqError:
                continue
            for wt in conhecidos:
                try:
                    rel = wt["path"].relative_to(root / repo)
                except ValueError:
                    continue                      # checkout principal, ou fora do root
                window = f"{repo}/{rel.as_posix()}"
                if window not in cands:
                    cands[window] = {"repo": repo, "slug": rel.as_posix(),
                                     "branch": wt.get("branch"),
                                     "path": str(wt["path"]), "origem": "git"}

        vivas = {p["window"] for p in list_panes(session)} if session_exists(session) else set()
        for window, meta in sorted(cands.items()):
            if not Path(meta["path"]).exists():
                orfaos.append((ws, window, meta["path"], meta["origem"], cfg))
                continue
            if window in vivas:
                continue
            plano.append((ws, session, window, meta))

    for ws, window, path, origem, _ in orfaos:
        print(f"  ignorado  {ws}  {window}  (path sumiu: {path})")

    # Limpeza preguicosa, mesmo principio do pane morto. Mas so vale pro que
    # veio do REGISTRO: orfao que o `git worktree list` ainda fornece volta na
    # proxima execucao, e podar o registro nao o remove. Esse e' `git worktree
    # prune`, que mexe no repo do usuario — entao o orq aponta, nao executa.
    do_registro = [o for o in orfaos if o[3] == "registro"]
    do_git = [o for o in orfaos if o[3] == "git"]
    if do_registro and not args.dry_run:
        for ws in {o[0] for o in do_registro}:
            mortos = {o[1] for o in do_registro if o[0] == ws}
            def mutate(state, m=mortos):
                for win in m:
                    state.get("worktrees", {}).pop(win, None)
            update_state(ws, mutate)
            log_event(cmd="resurrect", ws=ws, pruned=sorted(mortos), ok=True)
        print(f"  ({len(do_registro)} entrada(s) removida(s) do registro)")
    if do_git:
        repos = sorted({str(expand(o[4].get("repos", {}).get(o[1].split("/")[0], "?")))
                        for o in do_git})
        print(f"  o git ainda lista esse(s) path(s); pra parar de avisar rode:")
        for r in repos:
            print(f"    git -C {r} worktree prune")
    if not plano:
        print("nada a ressuscitar")
        return
    if args.dry_run:
        for ws, session, window, meta in plano:
            marca = "" if meta["origem"] == "registro" else "  [so o git sabia]"
            print(f"  seria recriada  {ws}:{window}  "
                  f"[{meta.get('branch') or '?'}]{marca}")
        return

    for ws, session, window, meta in plano:
        if not session_exists(session):
            cmd_up(argparse.Namespace(ws=ws), quiet=True)
            print(f"  sessao '{session}' recriada")
        tmux("new-window", "-d", "-t", f"={session}", "-n", window,
             "-c", meta["path"])
        if meta["origem"] == "git":
            def mutate(state, w=window, m=meta):
                state.setdefault("worktrees", {})[w] = {
                    k: v for k, v in m.items() if k != "origem"}
            update_state(ws, mutate)
        log_event(cmd="resurrect", ws=ws, wt=window, path=meta["path"],
                  origem=meta["origem"], ok=True)
        marca = "" if meta["origem"] == "registro" else "  [so o git sabia]"
        print(f"  recriada  {ws}:{window}  [{meta.get('branch') or '?'}]{marca}")


def fmt_pane(p):
    nome = p["name"] or "-"
    pai = f" <- {p['parent']}" if p["parent"] else ""
    sil = " zzz" if p["silence"] else ""
    st = f" [{p['status']}]" if p.get("status") else ""
    return f"    {p['pane']}  {nome}  {p['command']}{pai}{st}{sil}"


def cmd_schedule_add(args):
    if not NAME_RE.match(args.name):
        raise OrqError(f"nome invalido: '{args.name}' (esperado {NAME_RE.pattern})")
    if "/" in args.name:
        raise OrqError("nome de schedule nao aceita `/` (vira nome de unidade)")
    if not args.command:
        raise OrqError("falta o comando: `orq schedule add <nome> --cron '…' -- <comando>`")
    if bool(args.cron) == bool(args.calendar):
        raise OrqError("passe --cron OU --calendar, nao os dois nem nenhum")

    existentes = sched_units()
    if args.name in existentes:
        raise OrqError(f"schedule '{args.name}' ja existe — `orq schedule rm` antes")
    if len(existentes) >= SCHED_MAX:
        raise OrqError(f"teto de {SCHED_MAX} schedules atingido ({len(existentes)} ativos). "
                       f"remova algum antes — acumulo silencioso e' o risco real aqui")

    tz = orq_timezone()
    calendario = args.calendar or cron_to_calendar(args.cron, tz)
    proxima = calendar_next(calendario)          # valida antes de escrever

    # shlex.join, nao " ".join: o shell do usuario ja tirou as aspas, entao
    # juntar com espaco quebra qualquer argumento que tinha espaco dentro --
    # `claude -p "prompt longo"` viraria varios argumentos. shlex.join
    # reconstroi uma linha de shell equivalente ao argv original.
    cmd = shlex.join(args.command)
    ws = ws_arg(args)
    criador = caller_agent() or "humano"
    agora = datetime.now(timezone.utc).astimezone().isoformat()
    wd = str(lead_root(workspace_config(ws))) if ws else str(expand("~"))

    UNITS.mkdir(parents=True, exist_ok=True)
    unidade = f"{SCHED_PREFIX}{args.name}"
    # As linhas `# orq:` sao o registro. Nao ha copia em ~/.orq/ pra divergir.
    (UNITS / f"{unidade}.service").write_text(
        f"[Unit]\n"
        f"Description=orq schedule: {args.name}\n"
        f"# orq: nome={args.name}  ws={ws or '-'}  criador={criador}  em={agora}\n"
        f"# orq: calendario={calendario}\n"
        f"\n[Service]\n"
        f"Type=oneshot\n"
        f"WorkingDirectory={wd}\n"
        # Duas armadilhas do ExecStart, ambas silenciosas:
        # 1. NAO roda shell -- aspas, pipe e redirecionamento morreriam. Dai o
        #    wrap em `bash -lc`, mesma familia do wrap do `--cmd`.
        # 2. `%` e' ESPECIFICADOR do systemd e e' expandido antes do bash ver.
        #    Medido: `$(date +%T)` virou `$(date +/tmp)` porque %T e' o
        #    diretorio temporario. Dobrar e' o escape.
        f"ExecStart=/bin/bash -lc "
        f"{shlex.quote(cmd).replace('%', '%%')}\n"
    )
    (UNITS / f"{unidade}.timer").write_text(
        f"[Unit]\n"
        f"Description=orq schedule: {args.name}\n"
        f"\n[Timer]\n"
        f"OnCalendar={calendario}\n"
        f"Persistent=true\n"
        f"\n[Install]\n"
        f"WantedBy=timers.target\n"
    )
    systemctl("daemon-reload")
    systemctl("enable", "--now", f"{unidade}.timer")

    # Write-through: loga DEPOIS que o systemd confirmou, pra o log nunca
    # afirmar algo que nao existe.
    log_event(cmd="schedule add", name=args.name, ws=ws, criador=criador,
              calendario=calendario, comando=cmd, next=proxima, ok=True)
    print(f"{args.name}  ->  {unidade}.timer")
    print(f"  quando: {calendario}")
    print(f"  proxima execucao: {proxima}")
    print(f"  comando: {cmd}")


def schedule_rows(ws=None):
    """Linhas de schedule, lidas do systemd. Compartilhado pelo `schedule ls`
    e pelo `ls` -- o plano quer schedule e workspace na MESMA dashboard."""
    linhas = []
    for nome in sched_units():
        unidade = f"{SCHED_PREFIX}{nome}"
        props = systemctl("show", f"{unidade}.timer", "--property=NextElapseUSecRealtime",
                          "--property=LastTriggerUSec", "--property=ActiveState",
                          check=False).stdout
        d = dict(l.split("=", 1) for l in props.splitlines() if "=" in l)
        meta = sched_meta(nome)
        linhas.append({
            "name": nome, "unit": f"{unidade}.timer",
            "state": d.get("ActiveState"),
            "next": d.get("NextElapseUSecRealtime") or None,
            "last": d.get("LastTriggerUSec") or None,
            # `-` e' o marcador de vazio na unidade (texto); no JSON vira null
            "ws": (meta.get("ws") or None) if meta.get("ws") != "-" else None,
            "criador": meta.get("criador"),
            "calendario": meta.get("calendario"), "exec": meta.get("exec"),
        })
    if ws:
        linhas = [l for l in linhas if l["ws"] == ws]
    return linhas


def fmt_schedule(s_, indent="  "):
    marca = "" if s_["state"] == "active" else f"  ({s_['state']})"
    out = [f"{s_['name']}{marca}",
           f"{indent}quando: {s_['calendario'] or '?'}",
           f"{indent}proxima: {s_['next'] or '-'}"]
    if s_["last"]:
        out.append(f"{indent}ultima: {s_['last']}")
    out.append(f"{indent}criador: {s_['criador'] or '?'}   ws: {s_['ws'] or '-'}")
    out.append(f"{indent}exec: {s_['exec'] or '?'}")
    return "\n".join(out)


def cmd_schedule_ls(args):
    linhas = schedule_rows()
    if args.json:
        print(json.dumps(linhas, indent=2, ensure_ascii=False))
        return
    if not linhas:
        print("nenhum schedule")
        return
    for s_ in linhas:
        print(fmt_schedule(s_))


def cmd_schedule_rm(args):
    if args.name not in sched_units():
        raise OrqError(f"schedule '{args.name}' nao existe")
    unidade = f"{SCHED_PREFIX}{args.name}"
    systemctl("disable", "--now", f"{unidade}.timer", check=False)
    for sufixo in (".timer", ".service"):
        alvo = UNITS / f"{unidade}{sufixo}"
        if alvo.exists():
            alvo.unlink()
    systemctl("daemon-reload")
    log_event(cmd="schedule rm", name=args.name,
              criador=caller_agent() or "humano", ok=True)
    print(f"{args.name} removido")


def cmd_schedule_run(args):
    if args.name not in sched_units():
        raise OrqError(f"schedule '{args.name}' nao existe")
    unidade = f"{SCHED_PREFIX}{args.name}"
    systemctl("start", f"{unidade}.service")
    log_event(cmd="schedule run", name=args.name,
              criador=caller_agent() or "humano", ok=True)
    print(f"{args.name} disparado agora (fora da agenda)")


def cmd_ls(args):
    _ws = ws_arg(args)
    workspaces = [_ws] if _ws else sorted(
        p.stem for p in WORKSPACES.glob("*.yml")
    ) if WORKSPACES.exists() else []
    tree = []
    for ws in workspaces:
        try:
            cfg = workspace_config(ws)
        except OrqError:
            continue
        session = cfg.get("session") or ws
        state = read_state(ws)
        panes = list_panes(session) if session_exists(session) else []
        agentes = state.get("agents", {})
        # Detalhe #6: limpeza preguicosa. Pane morto vira nome orfao; some no
        # proximo `ls`. O id NUNCA e' reciclado — pane novo com nome antigo
        # seria mandar prompt pro agente errado.
        if session_exists(session):
            vivos = all_pane_ids()
            mortos = [n for n, a in agentes.items() if a.get("pane") not in vivos]
            if mortos:
                def limpa(st, m=mortos):
                    for n in m:
                        st.get("agents", {}).pop(n, None)
                update_state(ws, limpa)
                agentes = {n: a for n, a in agentes.items() if n not in mortos}
        janelas = {}
        for p in panes:
            reg = next((dict(a, name=n) for n, a in agentes.items()
                        if a.get("pane") == p["pane"]), None)
            janelas.setdefault(p["window"], []).append({
                "pane": p["pane"],
                "name": reg["name"] if reg else None,
                "provider": reg.get("provider") if reg else None,
                "parent": reg.get("parent") if reg else None,
                # `done` nao mata o pane, entao "pane vivo" nao distingue mais
                # trabalhando de terminado. O status e' o que distingue.
                "status": reg.get("status") if reg else None,
                # o comando real da arvore; `pane_current_command` reporta o
                # shell pros panes de split-window e mentia na tela.
                "command": next((c for c in p["procs"] if c not in SHELLS),
                                p["command"]),
                # O flag de silencio vem cru do tmux: repassar o dado nao e'
                # construir deteccao de ociosidade (que foi cortada).
                "silence": p["silence"] == "1",
            })
        # Fora antes do laco de worktrees: _lead nao e' worktree, e sem tirar
        # daqui ele cairia no balde de "janela sem registro" e seria anunciado
        # como worktree desconhecido.
        lead = janelas.pop(LEAD_WINDOW, [])
        wts = []
        for window, meta in sorted(state.get("worktrees", {}).items()):
            path = Path(meta["path"])
            wts.append({
                "worktree": window,
                "branch": meta.get("branch"),
                "path": meta["path"],
                "exists": path.exists(),
                "dirty": is_dirty(path, meta.get("orq_files")) if path.exists() else None,
                "window_alive": window in janelas,
                "panes": janelas.pop(window, []),
            })
        for window, panes_ in sorted(janelas.items()):   # janela sem registro
            wts.append({"worktree": window, "branch": None, "path": None,
                        "exists": None, "dirty": None, "window_alive": True,
                        "panes": panes_, "unregistered": True})
        tree.append({"workspace": ws, "session": session,
                     "session_alive": session_exists(session),
                     # os repos configurados sao o que se pode passar como
                     # <repo> no `wt new` — e' a informacao que se olha logo
                     # antes de criar worktree, entao mora aqui e nao num
                     # comando novo.
                     "repos": {k: str(expand(v))
                               for k, v in (cfg.get("repos") or {}).items()},
                     # o `root:` sai cru, sem validar: `ls` e' leitura, quem
                     # recusa root inexistente e' o `up` e o `spawn`.
                     "lead": {"window": LEAD_WINDOW,
                              "root": str(expand(cfg.get("root") or "~")),
                              "panes": lead},
                     "worktrees": wts})

    # Schedules entram na MESMA saida dos workspaces: e' a dashboard unica que
    # o plano pede, e o contrato "nada de estado so dentro da CLI" vale pra
    # eles tambem. Filtrados pelo workspace quando um foi pedido.
    scheds = schedule_rows(ws=_ws)

    if args.json:
        # ⚠️ Mudanca de forma: o topo era uma LISTA de workspaces e passa a ser
        # um objeto com `workspaces` e `schedules`. Feito agora porque a TUI da
        # Fase 5 ainda nao existe pra quebrar.
        print(json.dumps({"workspaces": tree, "schedules": scheds},
                         indent=2, ensure_ascii=False))
        return
    if not tree and not scheds:
        print("nenhum workspace em " + str(WORKSPACES))
        return
    for ws in tree:
        marca = "" if ws["session_alive"] else "  (sessao morta)"
        print(f"{ws['workspace']}{marca}")
        if ws["repos"]:
            print(f"  repos: {', '.join(sorted(ws['repos']))}")
        if ws["lead"]["panes"]:
            print(f"  {ws['lead']['window']}  ({ws['lead']['root']})")
            for p in ws["lead"]["panes"]:
                print(fmt_pane(p))
        for wt in ws["worktrees"]:
            sujo = " *" if wt["dirty"] else ""
            avisos = []
            if wt["exists"] is False:
                avisos.append("path sumiu")
            elif not wt["window_alive"]:
                # worktree vivo que perdeu a janela: e' o caso do `resurrect`.
                avisos.append("sem janela — `orq resurrect`")
            aviso = f"  ({'; '.join(avisos)})" if avisos else ""
            print(f"  {wt['worktree']}  [{wt['branch'] or '?'}]{sujo}{aviso}")
            for p in wt["panes"]:
                print(fmt_pane(p))

    if scheds:
        print("schedules")
        for s_ in scheds:
            print("  " + fmt_schedule(s_, indent="  ").replace("\n", "\n  "))


def cmd_log(args):
    _ws = ws_arg(args)
    if not LOG.exists():
        return
    with open(LOG) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            if _ws and ev.get("ws") != _ws:
                continue
            if args.action and ev.get("cmd") != args.action:
                continue
            if args.since and ev.get("ts", "") < args.since:
                continue
            print(json.dumps(ev, ensure_ascii=False))


# --- parser -----------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(prog="orq", description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    # Workspace: posicional OU --ws, em TODOS os comandos que o aceitam.
    # Antes `up`/`attach` exigiam posicional e o resto so aceitava --ws; a
    # assimetria era defensavel (um nao tem sessao pra inferir, o outro tem)
    # mas custava erro de digitacao a quem le -- inclusive a agente lendo o
    # SKILL.md, onde errar o comando custa um turno. Precedencia:
    # --ws > posicional > inferido da sessao tmux.
    sp = sub.add_parser("up", help="cria a sessao do workspace (idempotente)")
    sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--ws"); sp.set_defaults(func=cmd_up)

    sp = sub.add_parser("attach", help="tmux attach no workspace")
    sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--ws"); sp.set_defaults(func=cmd_attach)

    sp = sub.add_parser("wt", help="worktree: new | rm")
    wt = sp.add_subparsers(dest="wt_cmd", required=True)
    new = wt.add_parser("new", help="cria worktree + janela, base fresca de origin")
    new.add_argument("target", help="<repo>/<slug>")
    new.add_argument("ws_pos", nargs="?", metavar="ws")
    new.add_argument("--branch", required=True)
    new.add_argument("--base")
    new.add_argument("--ws")
    new.add_argument("--no-fetch", action="store_true")
    new.add_argument("--spawn", metavar="PROVIDER",
                     help="sobe um agente no worktree recem-criado")
    new.add_argument("--as", dest="as_name", metavar="NOME",
                     help="nome do agente do --spawn (default: o slug)")
    new.add_argument("--prompt", help="prompt inicial, com --spawn")
    new.add_argument("--no-files", action="store_true")
    new.add_argument("--no-hooks", action="store_true")
    new.set_defaults(func=cmd_wt_new)
    rm = wt.add_parser("rm", help="remove worktree e janela; nunca apaga branch")
    rm.add_argument("target")
    rm.add_argument("ws_pos", nargs="?", metavar="ws")
    rm.add_argument("--ws")
    rm.add_argument("--force", action="store_true")
    rm.set_defaults(func=cmd_wt_rm)

    sp = sub.add_parser("resurrect", help="recria janelas que cairam")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--ws")
    sp.set_defaults(func=cmd_resurrect)

    sp = sub.add_parser("spawn",
                        help="sobe um terminal/agente num worktree; sem --wt "
                             "nasce no root do workspace (janela _lead)")
    sp.add_argument("name"); sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--wt")
    sp.add_argument("--provider"); sp.add_argument("--cmd", dest="cmd_str")
    sp.add_argument("--prompt"); sp.add_argument("--parent")
    sp.add_argument("--split", action="store_true"); sp.add_argument("--ws")
    sp.set_defaults(func=cmd_spawn)

    sp = sub.add_parser("kill", help="mata o pane e tira do registro")
    sp.add_argument("name"); sp.set_defaults(func=cmd_kill)

    sp = sub.add_parser("send", help="cola um prompt no pane")
    sp.add_argument("name"); sp.add_argument("text")
    sp.add_argument("--no-enter", action="store_true")
    sp.set_defaults(func=cmd_send)

    sp = sub.add_parser("keys", help="manda teclas nomeadas")
    sp.add_argument("name"); sp.add_argument("keys", nargs="+")
    sp.set_defaults(func=cmd_keys)

    sp = sub.add_parser("read", help="capture-pane em texto puro")
    sp.add_argument("name"); sp.add_argument("--lines", type=int, default=200)
    sp.set_defaults(func=cmd_read)

    sp = sub.add_parser("done", help="fecha o turno: grava status e avisa o pai")
    sp.add_argument("msg", nargs="?", default=""); sp.add_argument("--to")
    sp.set_defaults(func=cmd_done)

    sp = sub.add_parser("_status",
                        help="interno: o hook do agente reporta o estado dele")
    sp.set_defaults(func=cmd_status_hook)

    sp = sub.add_parser("ls", help="arvore workspace -> worktree -> panes")
    sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--json", action="store_true"); sp.add_argument("--ws")
    sp.set_defaults(func=cmd_ls)

    sp = sub.add_parser("log", help="filtro sobre o log.jsonl")
    sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--since"); sp.add_argument("--ws"); sp.add_argument("--action")
    sp.set_defaults(func=cmd_log)

    sp = sub.add_parser("schedule", help="add | ls | rm | run")
    sc = sp.add_subparsers(dest="schedule_cmd", required=True)
    add = sc.add_parser("add"); add.add_argument("name")
    add.add_argument("--cron"); add.add_argument("--calendar"); add.add_argument("--ws")
    # O comando vem depois de `--` e e' separado ANTES do argparse (ver main).
    # Com nargs=REMAINDER aqui, argparse engolia as proprias flags: um
    # `add <nome> --cron "…"` virava command=["--cron", "…"] e o --cron nunca
    # era parseado.
    add.add_argument("command", nargs="*", default=[])
    add.set_defaults(func=cmd_schedule_add)
    sls = sc.add_parser("ls"); sls.add_argument("--json", action="store_true")
    sls.set_defaults(func=cmd_schedule_ls)
    srm = sc.add_parser("rm"); srm.add_argument("name")
    srm.set_defaults(func=cmd_schedule_rm)
    srun = sc.add_parser("run", help="dispara agora, sem esperar a agenda")
    srun.add_argument("name")
    srun.set_defaults(func=cmd_schedule_run)

    return p


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    # `--` separa o comando do usuario dos argumentos do orq. Fica fora do
    # argparse de proposito: dentro dele, REMAINDER engole flag.
    resto = None
    if "--" in argv:
        corte = argv.index("--")
        argv, resto = argv[:corte], argv[corte + 1:]
    args = build_parser().parse_args(argv)
    if resto is not None:
        args.command = resto
    try:
        args.func(args)
    except OrqError as e:
        sys.exit(f"orq: {e}")
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
