# --- schedules: systemd --user ----------------------------------------------

def systemctl(*a, check=True):
    return run(["systemctl", "--user", *a], check=check)


def orq_timezone():
    """The timezone written into every unit. NEVER omitted: when an agent asks
    for "every day at 7pm" it means the USER's 7pm, and it cannot know which
    timezone the box is in. The rule holds even with the machine set correctly
    -- on 2026-08-31 this host was on Etc/UTC and a bare `19:03` would have
    fired at 16:03."""
    cfg = load_yaml(CONFIG, "config.yml") if CONFIG.exists() else {}
    tz = (cfg or {}).get("timezone")
    if tz:
        return tz
    r = run(["timedatectl", "show", "-p", "Timezone", "--value"], check=False)
    return r.stdout.strip() or "UTC"


def _tok(tok):
    """Campo de cron -> campo de calendar systemd."""
    if tok == "*":
        return "*"
    t = tok.replace("-", "..")
    if t.startswith("*/"):
        t = "0/" + t[2:]
    return ",".join(x.zfill(2) if x.isdigit() else x for x in t.split(","))


def _dow(tok):
    if tok == "*":
        return ""
    names = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    def um(x):
        return names[int(x)] if x.isdigit() and int(x) <= 7 else x
    parts = []
    for parte in tok.split(","):
        if "-" in parte:
            a, b = parte.split("-", 1)
            parts.append(f"{um(a)}..{um(b)}")
        else:
            parts.append(um(parte))
    return ",".join(parts) + " "


def cron_to_calendar(expr, tz):
    fields = expr.split()
    if len(fields) != 5:
        raise OrqError(
            f"cron needs 5 fields (min hour day month weekday), "
            f"got {len(fields)}: '{expr}'"
        )
    m, h, dom, mon, dow = fields
    return (f"{_dow(dow)}*-{_tok(mon)}-{_tok(dom)} "
            f"{_tok(h)}:{_tok(m)}:00 {tz}")


def calendar_next(calendar):
    """`systemd-analyze calendar` is the free validator: it validates the
    expression AND prints the next run, so there is no hand-written cron parser
    to trust."""
    r = run(["systemd-analyze", "calendar", calendar], check=False)
    if r.returncode != 0:
        detalhe = (r.stderr or r.stdout or "").strip().splitlines()
        raise OrqError(f"invalid calendar '{calendar}': "
                       f"{detalhe[0] if detalhe else 'recusado pelo systemd'}")
    for line in r.stdout.splitlines():
        if "Next elapse:" in line:
            return line.split("Next elapse:", 1)[1].strip()
    return "?"


def sched_units():
    """What SYSTEMD knows about, not what happens to be on disk."""
    r = systemctl("list-unit-files", f"{SCHED_PREFIX}*.timer",
                  "--no-legend", "--plain", check=False)
    names = []
    for line in r.stdout.splitlines():
        fields = line.split()
        if fields and fields[0].endswith(".timer"):
            names.append(fields[0][len(SCHED_PREFIX):-len(".timer")])
    return sorted(names)


def sched_meta(name):
    """Metadata comes from the unit's own `# orq:` lines -- that is what makes
    the unit self-describing and removes any mirror that could drift."""
    r = systemctl("cat", f"{SCHED_PREFIX}{name}.service", check=False)
    meta, execstart = {}, None
    for line in r.stdout.splitlines():
        if line.startswith("Description="):
            meta["desc"] = sched_desc(name, line[len("Description="):])
        if line.startswith("# orq:"):
            for par in line[len("# orq:"):].strip().split("  "):
                if "=" in par:
                    k, v = par.split("=", 1)
                    meta[k.strip()] = v.strip()
        elif line.startswith("ExecStart="):
            execstart = line[len("ExecStart="):]
    meta["exec"] = execstart
    return meta


def sched_desc(name, description):
    """The description lives in the unit's `Description=` and nowhere else.

    Format: `orq schedule: <name>` without one, `orq schedule: <name> — <d>`
    with. It splits unambiguously because a name accepts neither spaces nor `—`
    (NAME_RE). It could have become one more `# orq:` line, but then the same
    sentence would live in two places -- and `Description=` is precisely the
    human field systemd already shows in `list-timers` and `status`."""
    prefix = f"orq schedule: {name}"
    if description and description.startswith(prefix + " — "):
        return description[len(prefix) + 3:]
    return ""


def cmd_up(args, quiet=False):
    ws = resolve_ws(ws_arg(args))
    cfg = workspace_config(ws)
    session = cfg.get("session") or ws
    if not session_exists(session):
        tmux("new-session", "-d", "-s", session, "-n", LEAD_WINDOW,
             "-c", str(lead_root(cfg)))
        # `set-option -t` takes a PANE target, so `=<session>` alone does not
        # resolve ("no such session"). The trailing `:` makes it a session
        # target, and the `=` still prevents matching a similarly named one.
        for opt in (("status-left", "#[bold] #S #[default]| "),
                    ("status-left-length", "18"),
                    ("status-interval", "5")):
            tmux("set-option", "-t", f"={session}:", opt[0], opt[1])
        tmux("set-window-option", "-t", f"={session}:", "monitor-silence", "10",
             check=False)
        log_event(cmd="up", ws=ws, session=session, created=True, ok=True)
        if not quiet:
            print(f"session '{session}' created")
    else:
        log_event(cmd="up", ws=ws, session=session, created=False, ok=True)
        if not quiet:
            print(f"session '{session}' already existed")
    if not quiet:
        print(f"attach:  tmux -L {SOCKET} attach -t {session}")


def cmd_attach(args):
    ws = resolve_ws(ws_arg(args))
    cfg = workspace_config(ws)
    session = cfg.get("session") or ws
    if not session_exists(session):
        raise OrqError(f"session '{session}' does not exist -- run `orq up {ws}`")
    os.execvp("tmux", ["tmux", "-L", SOCKET, "attach", "-t", session])


def cmd_wt_new(args):
    ws = resolve_ws(ws_arg(args))
    cfg = workspace_config(ws)
    session = cfg.get("session") or ws
    repo, slug = split_target(args.target)
    src = repo_path(cfg, repo)
    dst = worktree_path(cfg, repo, slug)
    branch = args.branch

    # Detalhe #7: up implicito.
    if not session_exists(session):
        cmd_up(argparse.Namespace(ws=ws), quiet=True)

    if dst.exists():
        raise OrqError(f"worktree already exists: {dst}")

    # Fresh base. `git fetch` does NOT move the local main -- only branching
    # off origin/<default> is genuinely fresh. A failing fetch aborts.
    if not args.no_fetch:
        git(src, "fetch", "origin", "--prune")

    reused = branch_exists(src, branch)
    if reused:
        # An existing branch is reused and NEVER rebased.
        base = branch
        git(src, "worktree", "add", str(dst), branch)
    else:
        base = args.base or default_remote_branch(src)
        git(src, "worktree", "add", str(dst), "-b", branch, base)
    base_sha = git(dst, "rev-parse", "HEAD").stdout.strip()

    ops = {"copied": [], "linked": []}
    if not args.no_files:
        ops = apply_file_ops(cfg, src, dst)
    if not args.no_hooks:
        run_post_create(cfg, dst)

    # Pitfall 1: `-d`. Without it the window steals the human's focus.
    window = f"{repo}/{slug}"
    tmux("new-window", "-d", "-t", f"={session}", "-n", window, "-c", str(dst))

    def mutate(state):
        state.setdefault("worktrees", {})[window] = {
            "repo": repo, "slug": slug, "branch": branch,
            "path": str(dst), "base": base, "base_sha": base_sha,
            # discounted from the dirty check: orq put these here, not the user
            "orq_files": sorted(ops["copied"] + ops["linked"]),
            "created_at": datetime.now(timezone.utc).astimezone().isoformat(),
        }
    update_state(ws, mutate)

    log_event(cmd="wt new", ws=ws, wt=window, repo=repo, branch=branch,
              path=str(dst), base=base, base_sha=base_sha, reused_branch=reused,
              files=ops, ok=True)
    print(f"{window}  ->  {dst}")
    print(f"  branch {branch} {'(reused, not rebased)' if reused else f'from {base} @ {base_sha[:8]}'}")
    if ops["copied"] or ops["linked"]:
        print(f"  files: {len(ops['copied'])} copied, {len(ops['linked'])} linked")

    # `wt new` + `spawn` is the most common sequence in orq. The flag had been
    # in the parser since Phase 1 and was never read: it accepted and ignored in
    # silence, which is worse than not existing -- the stubs at least refuse out
    # loud.
    if args.spawn:
        name = args.as_name or slug.replace("/", "-")
        cmd_spawn(argparse.Namespace(
            name=name, ws=ws, ws_pos=None, wt=window, provider=args.spawn,
            cmd_str=None, prompt=args.prompt, parent=None, split=False,
            parent_exec=getattr(args, "parent_exec", None),
            parent_exec_timeout=getattr(args, "parent_exec_timeout",
                                        PARENT_EXEC_TIMEOUT),
        ))


def cmd_wt_rm(args):
    ws = resolve_ws(ws_arg(args))
    cfg = workspace_config(ws)
    session = cfg.get("session") or ws
    repo, slug = split_target(args.target)
    window = f"{repo}/{slug}"
    src = repo_path(cfg, repo)
    dst = worktree_path(cfg, repo, slug)

    if not dst.exists():
        raise OrqError(f"worktree does not exist: {dst}")

    if not args.force:
        refusals = []
        ours = read_state(ws).get("worktrees", {}).get(window, {}).get("orq_files", [])
        dirty_list = dirty_entries(dst, ours)
        if dirty_list:
            sample = ", ".join(dirty_list[:3]) + ("…" if len(dirty_list) > 3 else "")
            refusals.append(f"the tree is dirty ({sample})")
        branch = git(dst, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
        unpushed = unpushed_commits(dst, branch)
        if unpushed:
            refusals.append(f"{len(unpushed)} commit(s) not on origin in '{branch}'")
        # "Agent alive" = a provider running INSIDE the pane. Reads the process
        # tree, not `pane_current_command`: the latter reports the shell for
        # panes born from split-window, and hid every agent from the second one
        # on. A bash left at a prompt still does not block.
        known = set(providers_config())
        alive = []
        for p in list_panes(session):
            if p["window"] != window:
                continue
            achados = [c for c in p["procs"] if c in known]
            if achados:
                alive.append((achados[0], p["pane"]))
        if alive:
            names = ", ".join(f"{c}@{pane}" for c, pane in alive)
            refusals.append(f"a live agent inside ({names})")
        if refusals:
            log_event(cmd="wt rm", ws=ws, wt=window, ok=False, refused=refusals)
            raise OrqError(
                f"refused: {'; '.join(refusals)}.\n"
                f"  use --force to remove anyway (the branch is NEVER deleted)"
            )

    # The files orq put here are untracked as far as git is concerned, so
    # without this `git worktree remove` refuses WHENEVER the workspace has
    # `files:` -- the dirty check already discounted them and the removal did
    # not, which jammed the command out of sheer inconsistency. A symlink always
    # goes (its target is untouched); a copy only goes if IDENTICAL to the
    # source, otherwise it is the user's edit and becomes a refusal instead of a
    # silent loss.
    ours = read_state(ws).get("worktrees", {}).get(window, {}).get("orq_files", [])
    # TWO passes: classify everything, decide, only then delete. In a single
    # pass the refusal arrived after the earlier items were already gone.
    removable, modified = [], []
    for rel in ours:
        target = dst / rel
        if target.is_symlink():
            removable.append(rel)                    # the link's target is untouched
        elif target.is_file():
            source = src / rel
            igual = source.is_file() and source.read_bytes() == target.read_bytes()
            (removable if (igual or args.force) else modified).append(rel)
        elif target.is_dir():
            removable.append(rel)
    if modified:
        log_event(cmd="wt rm", ws=ws, wt=window, ok=False, modified=modified)
        raise OrqError(
            f"refused: {', '.join(modified)} -- orq put that file (or those files) "
            f"here, but you have edited them since.\n"
            f"  save what matters and run again, or use --force to lose it"
        )

    removed = []
    for rel in removable:
        target = dst / rel
        if target.is_symlink() or target.is_file():
            target.unlink()
        elif target.is_dir():
            shutil.rmtree(target)
        removed.append(rel)

    # git FIRST. The other way around, a refusal from git left the window dead
    # and the worktree standing: the panes were lost and nothing was removed.
    try:
        git(src, "worktree", "remove", str(dst),
            *(["--force"] if args.force else []))
    except OrqError:
        # The removal failed AFTER we took out the files orq had put here.
        # Without putting them back the worktree survives mutilated -- with no
        # .env and no node_modules the app will not start, and nothing on screen
        # would explain why.
        if removed:
            apply_file_ops(cfg, src, dst)
        raise
    if window_exists(session, window):
        tmux("kill-window", "-t", f"={session}:{window}")

    def mutate(state):
        state.get("worktrees", {}).pop(window, None)
    update_state(ws, mutate)

    log_event(cmd="wt rm", ws=ws, wt=window, path=str(dst), forced=args.force,
              orq_files_removed=removed, ok=True)
    print(f"{window} removed (branch preserved)")
    if removed:
        print(f"  removed (placed by orq): {', '.join(removed)}")


def cmd_spawn(args):
    if not NAME_RE.match(args.name):
        raise OrqError(f"invalid name: '{args.name}' (expected {NAME_RE.pattern})")
    if args.cmd_str and args.prompt:
        raise OrqError("--prompt only makes sense with a provider, not with --cmd")
    ws = resolve_ws(ws_arg(args))
    cfg = workspace_config(ws)
    session = cfg.get("session") or ws

    state = read_state(ws)
    if args.name in (state.get("agents") or {}):
        raise OrqError(f"'{args.name}' is already in use in this workspace")

    made_window = False
    if args.wt:
        repo, slug = split_target(args.wt)
        window = f"{repo}/{slug}"
        meta = (state.get("worktrees") or {}).get(window)
        if not meta:
            raise OrqError(f"worktree '{window}' does not exist -- run `orq wt new` first")
        if not window_exists(session, window):
            raise OrqError(f"window '{window}' is not alive -- run `orq resurrect`")
        path = meta["path"]
    else:
        # With no --wt the agent is workspace-level: it is born at `root:`, in
        # the _lead window. The window is recreated if it vanished, because
        # `resurrect` only handles worktrees and the session may have lost just
        # this one.
        if not session_exists(session):
            raise OrqError(f"session '{session}' does not exist -- run `orq up {ws}`")
        window = LEAD_WINDOW
        path = str(lead_root(cfg))
        if not window_exists(session, window):
            tmux("new-window", "-d", "-t", f"={session}", "-n", window, "-c", path)
            made_window = True

    session_id = str(uuid.uuid4())
    if args.cmd_str:
        provider = None
        # `--cmd` runs literally, but wrapped: without this the pane CLOSES
        # when the tool exits, and vanishes before it can be read when the
        # output is short (git diff with less -F quits by itself when it fits).
        launch = f"{args.cmd_str}; exec $SHELL"
        binary = None
    else:
        provider = args.provider or cfg.get("provider") or "claude"
        base = provider_cmd(provider, session_id, cfg.get("mcp"))
        launch = f"{base}; exec $SHELL"
        binary = base.split()[0]
        pcfg = providers_config().get(provider) or {}
        ready_when = pcfg.get("ready_when") if isinstance(pcfg, dict) else None
        blocked_when = pcfg.get("blocked_when") if isinstance(pcfg, dict) else None

    # Take over the existing pane when the window has no registered agent and
    # that pane sits at an idle shell -- otherwise the first agent wastes half
    # the screen on a bash nobody asked for.
    panes = [p for p in list_panes(session) if p["window"] == window]
    registered = {a["pane"] for a in (state.get("agents") or {}).values()}
    # Free = a genuinely idle shell. `command in SHELLS` alone is not enough:
    # a pane with a live agent also reports a shell when it was born from
    # split-window, and taking it would paste the launch over a working agent.
    free = [p for p in panes if p["pane"] not in registered
              and p["command"] in SHELLS
              and all(c in SHELLS for c in p["procs"])]
    # A window spawn itself just created has exactly one pane, new and
    # nobody's -- it does not need the idle-shell heuristic, and it cannot use
    # it: for ~50ms after `new-window` tmux still reports `tmux` as
    # pane_current_command, so the pane would not match SHELLS and spawn would
    # split the window, leaving an orphan bash beside it.
    take = (not args.split) and (
        made_window or (len(panes) == 1 and len(free) == 1))

    if take:
        # In the freshly created window the only pane is ours and `free` is
        # empty from that same pane_current_command race -- take from `panes`.
        pane = (panes if made_window else free)[0]["pane"]
        tmux("send-keys", "-t", pane, "-l", launch)
        tmux("send-keys", "-t", pane, "Enter")
    else:
        # Pitfall 1: `-d`. Without it the new pane steals the human's focus.
        target = f"={session}:{window}"
        p = tmux("split-window", "-d", "-P", "-F", "#{pane_id}",
                 "-t", target, "-c", path, launch)
        pane = p.stdout.strip()

    parent = args.parent or caller_agent()
    # NOT inherited, and never derived from the caller. `parent` falls back to
    # caller_agent() because a pane is a place a message can be delivered; a
    # hook is a side effect somebody asked for. The adversarial reviewer is
    # born `--split` inside the worker's own worktree -- inheriting there would
    # fire the coordinator's webhook from a pane the coordinator never spawned.
    parent_exec = args.parent_exec

    def mutate(st):
        st.setdefault("agents", {})[args.name] = {
            "pane": pane, "wt": window if args.wt else None,
            "window": window, "provider": provider,
            "cmd": args.cmd_str, "session_id": session_id if provider else None,
            "parent": parent, "path": path,
            "parent_exec": parent_exec,
            "parent_exec_timeout": args.parent_exec_timeout if parent_exec else None,
            "created_at": datetime.now(timezone.utc).astimezone().isoformat(),
        }
    update_state(ws, mutate)
    log_event(cmd="spawn", ws=ws, wt=window if args.wt else None,
              window=window, name=args.name, pane=pane,
              provider=provider, cmd_str=args.cmd_str,
              session_id=session_id if provider else None, parent=parent,
              parent_exec=parent_exec, took_existing=take, ok=True)

    print(f"{args.name}  {pane}  in {window}"
          f"{f'  ({provider})' if provider else f'  ({args.cmd_str})'}"
          f"{'  [took the existing pane]' if take else ''}")
    if parent:
        print(f"  parent: {parent}")
    if parent_exec:
        print(f"  parent-exec: {parent_exec}")

    if args.prompt:
        ready, reason = wait_for_ready(pane, binary, ready_when, blocked_when)
        if not ready:
            log_event(cmd="spawn", ws=ws, name=args.name, pane=pane,
                      prompt_sent=False, reason=reason, ok=False)
            raise OrqError(
                f"'{args.name}' started, but the PROMPT WAS NOT SENT: {reason}.\n"
                f"  the pane is alive -- resolve it on screen and send with:\n"
                f"    orq send {args.name} \"...\""
            )
        paste_into(pane, args.prompt)
        log_event(cmd="send", ws=ws, name=args.name, pane=pane,
                  chars=len(args.prompt), source="spawn --prompt", ok=True)
        print(f"  prompt sent ({len(args.prompt)} chars)")


def cmd_send(args):
    ws, reg = find_agent(args.name)
    # Pitfall 6(b): does NOT check whether the input box is free. Claude Code
    # shows a contextual suggestion indistinguishable from typed text, and it
    # queues by itself whatever arrives mid-generation. Paste and send.
    paste_into(reg["pane"], args.text, enter=not args.no_enter)

    # New input means it is no longer "done". Without this the registry would
    # lie on a follow-up: the parent sends more work and `ls` keeps showing it
    # finished. Once the hooks land they overwrite with `working`; until then,
    # clearing beats asserting something untrue.
    if reg.get("status"):
        def mutate(st):
            a = (st.get("agents") or {}).get(args.name)
            if a is not None:
                a.pop("status", None); a.pop("status_at", None)
        update_state(ws, mutate)

    log_event(cmd="send", ws=ws, name=args.name, pane=reg["pane"],
              chars=len(args.text), enter=not args.no_enter, ok=True)


def cmd_keys(args):
    ws, reg = find_agent(args.name)
    tmux("send-keys", "-t", reg["pane"], *args.keys)
    log_event(cmd="keys", ws=ws, name=args.name, pane=reg["pane"],
              keys=args.keys, ok=True)


def run_parent_exec(cmd, timeout, payload):
    """Deliver a `done` to something that is not a pane.

    Returns None when the command succeeded, or a reason string when it did
    not. It NEVER raises and it never propagates a failure: `done` is a worker
    closing its turn, and a broken hook must not break the worker.

    The event goes in on STDIN, never in argv. `msg` is written by an agent and
    has carried newlines, quotes and em-dashes -- interpolating that into a
    shell line is a quoting bug at best and a command injection at worst. The
    ORQ_* variables are the convenience for hooks that do not want to parse
    JSON (`--parent-exec 'touch /tmp/orq-done-$ORQ_NAME'`).
    """
    env = dict(os.environ)
    env.update({
        "ORQ_WS": payload["ws"] or "",
        "ORQ_NAME": payload["name"] or "",
        "ORQ_PANE": payload["pane"] or "",
        "ORQ_WT": payload.get("wt") or "",
        "ORQ_MSG": payload.get("msg") or "",
        "ORQ_TS": payload["ts"],
    })
    try:
        # `sh -c` so that a pipe and a redirect work in the hook. The child is
        # a plain process: outside tmux, it does not inherit the pane as a TTY.
        p = subprocess.run(["sh", "-c", cmd],
                           input=json.dumps(payload, ensure_ascii=False),
                           text=True, capture_output=True,
                           timeout=timeout, env=env)
    except subprocess.TimeoutExpired:
        return f"parent_exec timeout {timeout:g}s"
    except Exception as e:                    # no sh, fork failure, bad cwd
        return f"parent_exec failed: {e}"
    if p.returncode != 0:
        # 127 is the shell saying the command does not exist -- the most
        # common way this fails, and worth reading straight off the log.
        return f"parent_exec exit {p.returncode}"
    return None


def cmd_done(args):
    """Closes the turn: writes the status to the registry and notifies the
    parent.

    It does NOT kill the pane. `done` means "I finished my turn", not "the work
    is over" -- the work ends at the merge, and the cleanup belongs to `wt rm`.
    The pane stays up with the conversation on screen, ready for a follow-up
    with no --resume cost.

    There is no `orq wait` on the other side: a parent that ended its turn is
    already idle waiting for input, and this send arrives as a new message and
    wakes it.
    """
    name = caller_agent()
    if not name:
        raise OrqError(
            "`done` is only valid from inside a registered agent's pane -- "
            "$TMUX_PANE matches no agent in the registry"
        )
    ws, reg = find_agent(name)

    set_status(ws, name, "done")

    dest = args.to or reg.get("parent")
    msg = f"[{name}] done" + (f": {args.msg}" if args.msg else "")

    # Two independent paths, and BOTH are attempted: the pane sees the message
    # go by while the hook wakes a coordinator that has no pane at all. `via`
    # says which ones delivered; `reason` accumulates the ones that did not.
    # `--to` still overrides the registered parent rather than adding to it --
    # that is the current meaning of the flag and it does not change here.
    hook = reg.get("parent_exec")
    via, reasons = [], []

    if hook:
        # Attempted before the pane, so that a `--to` naming nobody -- which
        # still raises, as it always has -- cannot swallow the hook.
        failure = run_parent_exec(
            hook, reg.get("parent_exec_timeout") or PARENT_EXEC_TIMEOUT,
            {"cmd": "done", "ws": ws, "name": name, "pane": reg["pane"],
             "wt": reg.get("wt"), "to": dest, "msg": args.msg,
             "ts": datetime.now(timezone.utc).astimezone().isoformat()})
        (reasons.append(failure) if failure else via.append("parent_exec"))

    def event(**extra):
        f = {"cmd": "done", "ws": ws, "name": name, "pane": reg["pane"],
             "msg": args.msg, "delivered": bool(via)}
        if via:
            f["via"] = ",".join(via)
        if reasons:
            f["reason"] = "; ".join(reasons)
        return {**f, **extra}

    # The status is written before delivery is attempted, and is not undone if
    # delivery fails: whoever finished finished, recipient or no recipient.
    if not dest:
        # With no hook configured this is the untouched original path, down to
        # `reason: "sem parent_"` -- the string anyone greps the log for.
        if not hook:
            log_event(cmd="done", ws=ws, name=name, pane=reg["pane"], to=None,
                      msg=args.msg, delivered=False, reason="sem parent_", ok=True)
            print(f"{name}: status done recorded")
            print("  nobody notified -- no parent in the registry and no --to")
            return
        log_event(**event(to=None, ok=True))
        print(f"{name}: status done recorded")
        print(f"  no pane to notify; parent-exec "
              f"{'delivered' if via else 'FAILED: ' + '; '.join(reasons)}")
        return

    try:
        _, reg_pai = find_agent(dest)
    except OrqError as e:
        reasons.append(str(e))
        log_event(**event(to=dest, ok=False))
        raise OrqError(
            f"status done recorded, but '{dest}' was not notified: {e}"
            + ("  (the parent-exec hook did fire)" if via else ""))

    paste_into(reg_pai["pane"], msg)
    via.append("pane")
    log_event(**event(to=dest, to_pane=reg_pai["pane"], ok=True))
    print(f"{name}: status done recorded; notified '{dest}' ({reg_pai['pane']})")
    if hook and "parent_exec" not in via:
        print(f"  parent-exec FAILED: {'; '.join(reasons)}")


def cmd_status_hook(args):
    """Called BY the agent, through the provider's hook. Reads the payload on
    stdin and translates the event into a status.

    Silent by contract, and it swallows every exception: a hook that talks
    pollutes the agent's screen and a hook that breaks disturbs its turn. It
    does not write to log.jsonl -- the log is for commands somebody issued, and
    the state lives in the registry, which already comes out of `orq ls --json`.
    """
    try:
        payload = json.loads(sys.stdin.read() or "{}")
        status = HOOK_STATUS.get(payload.get("hook_event_name"))
        if not status:
            return
        ws, name = agent_by(payload.get("session_id"),
                            os.environ.get("TMUX_PANE"))
        if ws:
            set_status(ws, name, status)
    except Exception:
        return


def cmd_read(args):
    _, reg = find_agent(args.name)
    # Pitfall 2: capture-pane right after writing returns the previous frame.
    # Read twice; the second one is the good one.
    tmux("capture-pane", "-p", "-t", reg["pane"], "-S", f"-{args.lines}")
    out = tmux("capture-pane", "-p", "-t", reg["pane"], "-S", f"-{args.lines}")
    print(out.stdout.rstrip())


def warn_if_session_gone(ws=None):
    """tmux closes a window when its last pane exits, and the session when its
    last window goes. So killing the only agent in `_lead` takes the whole
    session with it -- correct, and surprising enough that saying nothing is
    the actual defect. Nothing is lost: the session is disposable by design,
    the registry is an index and git holds the worktrees."""
    names = [ws] if ws else sorted(
        p.stem for p in WORKSPACES.glob("*.yml")) if WORKSPACES.exists() else []
    for name in names:
        try:
            cfg = workspace_config(name)
        except OrqError:
            continue
        session = cfg.get("session") or name
        if not session_exists(session):
            print(f"  that was the last pane: session '{session}' is gone. "
                  f"`orq up {name}` brings it back")


def cmd_kill(args):
    """Kills by agent name, or by pane id (`%12`).

    The pane id matters because a pane does not need an agent to exist: a
    worktree window is born with a plain shell, and `--cmd` panes are never
    named either. Accepting only registered names meant the dashboard could
    LIST panes it had no way to act on -- the asymmetry showed up the moment
    somebody pressed `k` on one and nothing happened.
    """
    if args.name.startswith("%"):
        pane = args.name
        if pane not in all_pane_ids():
            raise OrqError(f"pane {pane} does not exist")
        tmux("kill-pane", "-t", pane, check=False)
        # An unnamed pane may still be registered under a name -- prune it, or
        # the registry keeps pointing at something that is gone.
        killed_name = None
        if WORKSPACES.exists():
            for f in sorted(WORKSPACES.glob("*.yml")):
                agents = read_state(f.stem).get("agents") or {}
                for name, reg in agents.items():
                    if reg.get("pane") == pane:
                        killed_name = name

                        def mutate(st, n=name):
                            st.get("agents", {}).pop(n, None)
                        update_state(f.stem, mutate)
        log_event(cmd="kill", pane=pane, name=killed_name, ok=True)
        print(f"{pane} killed" + (f" (was '{killed_name}')" if killed_name else ""))
        warn_if_session_gone()
        return

    ws, reg = find_agent(args.name)
    tmux("kill-pane", "-t", reg["pane"], check=False)

    def mutate(st):
        st.get("agents", {}).pop(args.name, None)
    update_state(ws, mutate)
    log_event(cmd="kill", ws=ws, name=args.name, pane=reg["pane"], ok=True)
    print(f"{args.name} ({reg['pane']}) killed")
    warn_if_session_gone(ws)


def cmd_resurrect(args):
    """A worktree alive on disk that lost its window -- the classic case is a
    reboot, which takes the whole tmux server and touches nothing in git.

    It does NOT resurrect agents: the window comes back with a plain shell.
    Whoever wants an agent calls `spawn`, because deciding which agents were
    worth bringing back, and with what prompt, is judgement -- and judgement is
    the work of an agent reading the log, not of a command.
    """
    _ws = ws_arg(args)
    workspaces = [_ws] if _ws else sorted(
        p.stem for p in WORKSPACES.glob("*.yml")) if WORKSPACES.exists() else []
    plano, orphans = [], []
    for ws in workspaces:
        try:
            cfg = workspace_config(ws)
        except OrqError:
            continue
        session = cfg.get("session") or ws
        state = read_state(ws)
        root = expand(cfg.get("worktrees") or "~/wt")

        # 1. the registry
        cands = {w: dict(m, source="registry")
                 for w, m in (state.get("worktrees") or {}).items()}

        # 2. git, which catches what the registry lost
        for repo, rp in (cfg.get("repos") or {}).items():
            try:
                known = git_worktrees(expand(rp))
            except OrqError:
                continue
            for wt in known:
                try:
                    rel = wt["path"].relative_to(root / repo)
                except ValueError:
                    continue                      # checkout principal, ou fora do root
                window = f"{repo}/{rel.as_posix()}"
                if window not in cands:
                    cands[window] = {"repo": repo, "slug": rel.as_posix(),
                                     "branch": wt.get("branch"),
                                     "path": str(wt["path"]), "source": "git"}

        vivas = {p["window"] for p in list_panes(session)} if session_exists(session) else set()
        for window, meta in sorted(cands.items()):
            if not Path(meta["path"]).exists():
                orphans.append((ws, window, meta["path"], meta["source"], cfg))
                continue
            if window in vivas:
                continue
            plano.append((ws, session, window, meta))

    for ws, window, path, source, _ in orphans:
        print(f"  skipped  {ws}  {window}  (path is gone: {path})")

    # Lazy cleanup, same principle as the dead pane. But it only applies to
    # what came from the REGISTRY: an orphan `git worktree list` still reports
    # comes back on the next run, and pruning the registry does not remove it.
    # That is `git worktree prune`, which touches the user's repo -- so orq
    # points at it instead of running it.
    from_registry = [o for o in orphans if o[3] == "registry"]
    do_git = [o for o in orphans if o[3] == "git"]
    if from_registry and not args.dry_run:
        for ws in {o[0] for o in from_registry}:
            dead = {o[1] for o in from_registry if o[0] == ws}
            def mutate(state, m=dead):
                for win in m:
                    state.get("worktrees", {}).pop(win, None)
            update_state(ws, mutate)
            log_event(cmd="resurrect", ws=ws, pruned=sorted(dead), ok=True)
        print(f"  ({len(from_registry)} stale entr(y/ies) pruned from the registry)")
    if do_git:
        repos = sorted({str(expand(o[4].get("repos", {}).get(o[1].split("/")[0], "?")))
                        for o in do_git})
        print(f"  git still lists that path; to stop the warning run:")
        for r in repos:
            print(f"    git -C {r} worktree prune")
    if not plano:
        print("nothing to resurrect")
        return
    if args.dry_run:
        for ws, session, window, meta in plano:
            mark = "" if meta["source"] == "registry" else "  [only git knew]"
            print(f"  would recreate  {ws}:{window}  "
                  f"[{meta.get('branch') or '?'}]{mark}")
        return

    for ws, session, window, meta in plano:
        if not session_exists(session):
            cmd_up(argparse.Namespace(ws=ws), quiet=True)
            print(f"  session '{session}' recreated")
        tmux("new-window", "-d", "-t", f"={session}", "-n", window,
             "-c", meta["path"])
        if meta["source"] == "git":
            def mutate(state, w=window, m=meta):
                state.setdefault("worktrees", {})[w] = {
                    k: v for k, v in m.items() if k != "source"}
            update_state(ws, mutate)
        log_event(cmd="resurrect", ws=ws, wt=window, path=meta["path"],
                  source=meta["source"], ok=True)
        mark = "" if meta["source"] == "registry" else "  [only git knew]"
        print(f"  recreated  {ws}:{window}  [{meta.get(chr(39)+chr(98)+chr(114)+chr(97)+chr(110)+chr(99)+chr(104)+chr(39)) or chr(63)}]{mark}")


def fmt_pane(p):
    name = p["name"] or "-"
    parent_ = f" <- {p['parent']}" if p["parent"] else ""
    sil = " zzz" if p["silence"] else ""
    st = f" [{p['status']}]" if p.get("status") else ""
    return f"    {p['pane']}  {name}  {p['command']}{parent_}{st}{sil}"


def cmd_schedule_add(args):
    if not NAME_RE.match(args.name):
        raise OrqError(f"invalid name: '{args.name}' (expected {NAME_RE.pattern})")
    if "/" in args.name:
        raise OrqError("a schedule name cannot contain `/` (it becomes a unit name)")
    if not args.command:
        raise OrqError("missing command: `orq schedule add <name> --cron '…' -- <command>`")
    if bool(args.cron) == bool(args.calendar):
        raise OrqError("pass --cron OR --calendar, not both and not neither")

    existing = sched_units()
    if args.name in existing:
        raise OrqError(f"schedule '{args.name}' already exists -- `orq schedule rm` it first")
    if len(existing) >= SCHED_MAX:
        raise OrqError(f"ceiling of {SCHED_MAX} schedules reached ({len(existing)} active). "
                       f"remove one first -- silent accumulation is the real risk here")

    tz = orq_timezone()
    calendar = args.calendar or cron_to_calendar(args.cron, tz)
    next_at = calendar_next(calendar)          # validate before writing anything

    # shlex.join, not " ".join: the user's shell already stripped the quotes,
    # so joining on spaces breaks any argument that had a space inside --
    # `claude -p "long prompt"` would become several arguments. shlex.join
    # rebuilds a shell line equivalent to the original argv.
    cmd = shlex.join(args.command)
    creator = caller_agent() or "human"
    agora = datetime.now(timezone.utc).astimezone().isoformat()
    # A schedule used to take `--ws`, which set this directory AND filed the
    # unit under a workspace. Dropped on 2026-09-02: it did not do what its
    # name promised (deleting the workspace left the schedule running with a
    # frozen WorkingDirectory, and nothing ever revalidated it), and it
    # contradicted the thesis that a schedule is only "when" plus "what".
    # `--cwd` does the one thing that was actually useful and promises nothing
    # else.
    wd = expand(args.cwd) if args.cwd else expand("~")
    if not wd.is_dir():
        raise OrqError(f"--cwd '{wd}' does not exist or is not a directory")
    wd = str(wd)

    UNITS.mkdir(parents=True, exist_ok=True)
    unit = f"{SCHED_PREFIX}{args.name}"
    # The `# orq:` lines ARE the registry. No copy under ~/.orq/ to drift.
    title = f"orq schedule: {args.name}"
    if args.desc:
        title += f" — {args.desc}"
    (UNITS / f"{unit}.service").write_text(
        f"[Unit]\n"
        f"Description={title}\n"
        f"# orq: name={args.name}  creator={creator}  at={agora}\n"
        f"# orq: calendar={calendar}\n"
        f"\n[Service]\n"
        f"Type=oneshot\n"
        f"WorkingDirectory={wd}\n"
        # Two ExecStart pitfalls, both silent:
        # 1. It does NOT run a shell -- quotes, pipes and redirection would
        #    die. Hence the `bash -lc` wrap, same family as the `--cmd` wrap.
        # 2. `%` is a systemd SPECIFIER, expanded before bash ever sees it.
        #    Measured: `$(date +%T)` ran as `$(date +/tmp)` because %T is the
        #    temporary directory. Doubling it is the escape.
        f"ExecStart=/bin/bash -lc "
        f"{shlex.quote(cmd).replace('%', '%%')}\n"
    )
    (UNITS / f"{unit}.timer").write_text(
        f"[Unit]\n"
        f"Description={title}\n"
        f"\n[Timer]\n"
        f"OnCalendar={calendar}\n"
        f"Persistent=true\n"
        f"\n[Install]\n"
        f"WantedBy=timers.target\n"
    )
    systemctl("daemon-reload")
    systemctl("enable", "--now", f"{unit}.timer")

    # Write-through: log AFTER systemd confirmed, so the log never asserts
    # something that does not exist.
    log_event(cmd="schedule add", name=args.name, cwd=wd, creator=creator,
              calendar=calendar, command_str=cmd, next=next_at, ok=True)
    print(f"{args.name}  ->  {unit}.timer")
    print(f"  when: {calendar}")
    print(f"  next run: {next_at}")
    if args.desc:
        print(f"  description: {args.desc}")
    print(f"  command: {cmd}")


def sched_result(name):
    """Result of the LAST run. `schedule ls` shows the timer's state, which
    does not say whether the job passed or broke -- a schedule that fails
    every day looks healthy there.

    `ActiveEnterTimestamp` is NO USE here: a Type=oneshot goes inactive
    immediately and never fills it in, not even on success -- the first
    version of this returned "-" for everything, including the job that had
    just failed. The one that says "it already ran" is ExecMainStartTimestamp.
    """
    r = systemctl("show", f"{SCHED_PREFIX}{name}.service",
                  "--property=Result", "--property=ExecMainStatus",
                  "--property=ExecMainStartTimestamp", check=False)
    d = dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)
    if not d.get("ExecMainStartTimestamp"):
        return "-"
    if d.get("Result") == "success":
        return "ok"
    return f"{d.get('Result') or '?'} ({d.get('ExecMainStatus')})"


def schedule_rows():
    """Rows of schedules, read from systemd. Shared by `schedule ls` and by
    `ls` -- the plan wants schedules and workspaces on the SAME dashboard.

    There is no workspace filter: a schedule belongs to no workspace. Filtering
    used to hide global jobs from every per-workspace view, which is exactly
    where a broken backup would go unnoticed."""
    rows = []
    for name in sched_units():
        unit = f"{SCHED_PREFIX}{name}"
        props = systemctl("show", f"{unit}.timer", "--property=NextElapseUSecRealtime",
                          "--property=LastTriggerUSec", "--property=ActiveState",
                          check=False).stdout
        d = dict(l.split("=", 1) for l in props.splitlines() if "=" in l)
        meta = sched_meta(name)
        rows.append({
            "name": name, "unit": f"{unit}.timer",
            "state": d.get("ActiveState"),
            "next": d.get("NextElapseUSecRealtime") or None,
            "last": d.get("LastTriggerUSec") or None,
            "creator": meta.get("creator"),
            # The single most important fact about a schedule, and the one
            # `systemctl list-timers` does not carry: a job that fails every
            # day looks perfectly healthy there.
            "result": sched_result(name),
            "calendar": meta.get("calendar"), "exec": meta.get("exec"),
            "desc": meta.get("desc") or "",
        })
    return rows


def fmt_schedule(s_, indent="  "):
    mark = "" if s_["state"] == "active" else f"  ({s_['state']})"
    out = [f"{s_['name']}{mark}" + (f"  — {s_['desc']}" if s_.get("desc") else ""),
           f"{indent}when: {s_['calendar'] or '?'}",
           f"{indent}next: {s_['next'] or '-'}"]
    if s_["last"]:
        out.append(f"{indent}last: {s_['last']}")
    out.append(f"{indent}creator: {s_['creator'] or '?'}")
    out.append(f"{indent}exec: {s_['exec'] or '?'}")
    return "\n".join(out)


def cmd_schedule_ls(args):
    rows = schedule_rows()
    if args.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        return
    if not rows:
        print("no schedules")
        return
    for s_ in rows:
        print(fmt_schedule(s_))


def cmd_schedule_log(args):
    """What the last run printed. The `orq read` of a schedule.

    Without it there is nowhere to answer "why did it fail" -- the exit code
    says something broke and nothing says what. journalctl already keeps it;
    this only points at the right unit so nobody has to remember the name
    mangling."""
    if args.name not in sched_units():
        raise OrqError(f"schedule '{args.name}' does not exist")
    p = run(["journalctl", "--user", "-u", f"{SCHED_PREFIX}{args.name}.service",
             "-n", str(args.lines), "--no-pager", "-o", "cat"], check=False)
    out = (p.stdout or "").rstrip()
    print(out or "(no output recorded for this schedule yet)")


def cmd_schedule_rm(args):
    if args.name not in sched_units():
        raise OrqError(f"schedule '{args.name}' does not exist")
    unit = f"{SCHED_PREFIX}{args.name}"
    systemctl("disable", "--now", f"{unit}.timer", check=False)
    for target in (UNITS / f"{unit}.timer", UNITS / f"{unit}.service",
                   TIMER_STAMPS / f"stamp-{unit}.timer"):
        if target.exists():
            target.unlink()
    systemctl("daemon-reload")
    log_event(cmd="schedule rm", name=args.name,
              creator=caller_agent() or "human", ok=True)
    print(f"{args.name} removed")


def cmd_schedule_run(args):
    if args.name not in sched_units():
        raise OrqError(f"schedule '{args.name}' does not exist")
    unit = f"{SCHED_PREFIX}{args.name}"
    systemctl("start", f"{unit}.service")
    log_event(cmd="schedule run", name=args.name,
              creator=caller_agent() or "human", ok=True)
    print(f"{args.name} fired now (off schedule)")


def ls_tree(_ws=None):
    """The workspace -> worktree -> panes tree. Extracted from `ls` so that
    `dash` reads the SAME source -- built separately, the two would drift."""
    workspaces = [_ws] if _ws else sorted(
        p.stem for p in WORKSPACES.glob("*.yml")
    ) if WORKSPACES.exists() else []
    tree = []
    for ws in workspaces:
        try:
            cfg = workspace_config(ws)
        except OrqError:
            continue
        session = cfg.get("session") or ws
        state = read_state(ws)
        panes = list_panes(session) if session_exists(session) else []
        agents = state.get("agents", {})
        # Detail #6: lazy cleanup. A dead pane leaves an orphan name; it goes
        # away on the next `ls`. The id is NEVER recycled -- a new pane under an
        # old name would mean sending a prompt to the wrong agent.
        if session_exists(session):
            alive = all_pane_ids()
            dead = [n for n, a in agents.items() if a.get("pane") not in alive]
            if dead:
                def limpa(st, m=dead):
                    for n in m:
                        st.get("agents", {}).pop(n, None)
                update_state(ws, limpa)
                agents = {n: a for n, a in agents.items() if n not in dead}
        windows = {}
        for p in panes:
            reg = next((dict(a, name=n) for n, a in agents.items()
                        if a.get("pane") == p["pane"]), None)
            windows.setdefault(p["window"], []).append({
                "pane": p["pane"],
                "name": reg["name"] if reg else None,
                "provider": reg.get("provider") if reg else None,
                "parent": reg.get("parent") if reg else None,
                # The command `done` runs for a parent that is not a pane.
                "parent_exec": reg.get("parent_exec") if reg else None,
                # `done` does not kill the pane, so "pane alive" no longer
                # tells working from finished. The status is what does.
                "status": reg.get("status") if reg else None,
                # when the status changed; `dash` derives "how long ago"
                "status_at": reg.get("status_at") if reg else None,
                # the real command from the tree; `pane_current_command`
                # reports the shell for split-window panes and lied on screen.
                "command": next((c for c in p["procs"] if c not in SHELLS),
                                p["command"]),
                # The silence flag comes raw from tmux: passing the datum
                # through is not building idle detection (which was cut).
                "silence": p["silence"] == "1",
            })
        # Pulled out before the worktree loop: _lead is not a worktree, and
        # without removing it here it would fall into the "unregistered window"
        # bucket and be announced as an unknown worktree.
        lead = windows.pop(LEAD_WINDOW, [])
        wts = []
        for window, meta in sorted(state.get("worktrees", {}).items()):
            path = Path(meta["path"])
            wts.append({
                "worktree": window,
                "branch": meta.get("branch"),
                "path": meta["path"],
                "exists": path.exists(),
                "dirty": is_dirty(path, meta.get("orq_files")) if path.exists() else None,
                "window_alive": window in windows,
                "panes": windows.pop(window, []),
            })
        for window, panes_ in sorted(windows.items()):   # window sem registro
            wts.append({"worktree": window, "branch": None, "path": None,
                        "exists": None, "dirty": None, "window_alive": True,
                        "panes": panes_, "unregistered": True})
        tree.append({"workspace": ws, "session": session,
                     "session_alive": session_exists(session),
                     # the configured repos are what you can pass as <repo>
                     # to `wt new` -- it is what you look at right before
                     # creating a worktree, so it lives here instead of in a
                     # new command.
                     "repos": {k: str(expand(v))
                               for k, v in (cfg.get("repos") or {}).items()},
                     # `root:` goes out raw, unvalidated: `ls` is a read; the
                     # ones that refuse a missing root are `up` and `spawn`.
                     "lead": {"window": LEAD_WINDOW,
                              "root": str(expand(cfg.get("root") or "~")),
                              "panes": lead},
                     "worktrees": wts})
    return tree


def cmd_ls(args):
    _ws = ws_arg(args)
    tree = ls_tree(_ws)

    # Schedules go into the SAME output as the workspaces: it is the single
    # dashboard the plan asks for, and the "no state lives only inside the CLI"
    # contract applies to them too. Filtered by workspace when one was asked for.
    scheds = schedule_rows()

    if args.json:
        # Shape change: the top level used to be a LIST of workspaces and is
        # now an object with `workspaces` and `schedules`. Done now because the
        # Phase 5 TUI does not exist yet to break.
        print(json.dumps({"workspaces": tree, "schedules": scheds},
                         indent=2, ensure_ascii=False))
        return
    if not tree and not scheds:
        print("no workspaces in " + str(WORKSPACES))
        return
    for ws in tree:
        mark = "" if ws["session_alive"] else "  (session dead)"
        print(f"{ws['workspace']}{mark}")
        if ws["repos"]:
            print(f"  repos: {', '.join(sorted(ws['repos']))}")
        if ws["lead"]["panes"]:
            print(f"  {ws['lead']['window']}  ({ws['lead']['root']})")
            for p in ws["lead"]["panes"]:
                print(fmt_pane(p))
        for wt in ws["worktrees"]:
            sujo = " *" if wt["dirty"] else ""
            notes = []
            if wt["exists"] is False:
                notes.append("path gone")
            elif not wt["window_alive"]:
                # worktree vivo que perdeu a window: e' o caso do `resurrect`.
                notes.append("no window -- `orq resurrect`")
            note = f"  ({'; '.join(notes)})" if notes else ""
            print(f"  {wt['worktree']}  [{wt['branch'] or '?'}]{sujo}{note}")
            for p in wt["panes"]:
                print(fmt_pane(p))

    if scheds:
        print("schedules")
        for s_ in scheds:
            print("  " + fmt_schedule(s_, indent="  ").replace("\n", "\n  "))


# --- dash: hands over to the separate Textual program ------------------------

def cmd_dash(args):
    """`orq dash` runs `orq-dash`, a SEPARATE program that lives beside this
    file and talks to orq only through the CLI contract.

    Separate program, same command: orq never imports Textual, so it keeps the
    property that made Python win over Rust here -- one file, no build, fixable
    at 2am -- while the user still has one surface to remember. The coupling is
    a path, not an import: if the dashboard is missing or its venv is not set
    up, this says so instead of pretending the command does not exist.
    """
    here = Path(sys.argv[0]).resolve().parent
    sibling = here / "orq-dash"
    if not sibling.exists():
        raise OrqError(
            f"dashboard not installed: {sibling} is missing.\n"
            f"  it is a separate program; see requirements.txt"
        )
    # The interpreter is found HERE, at run time, instead of being baked into
    # the dashboard's shebang. An absolute shebang only holds on the machine
    # and in the directory it was written for: move the repo, or clone it
    # anywhere else, and the file reports itself as a bad interpreter.
    venv = here / ".venv/bin/python"
    python = str(venv) if venv.exists() else sys.executable
    rest = []
    ws = ws_arg(args)
    if ws:
        rest = ["--ws", ws]
    try:
        os.execv(python, [python, str(sibling), *rest])
    except OSError as e:
        raise OrqError(
            f"could not start {sibling}: {e}\n"
            f"  the dashboard needs its venv: python3 -m venv .venv && "
            f".venv/bin/pip install -r requirements.txt"
        )


def cmd_log(args):
    _ws = ws_arg(args)
    if not LOG.exists():
        return
    with open(LOG) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            if _ws and ev.get("ws") != _ws:
                continue
            if args.action and ev.get("cmd") != args.action:
                continue
            if args.since and ev.get("ts", "") < args.since:
                continue
            print(json.dumps(ev, ensure_ascii=False))


# --- parser -----------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(prog="orq", description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    # Workspace: positional OR --ws, on EVERY command that takes one.
    # Before, `up`/`attach` required the positional and the rest only accepted
    # --ws; the asymmetry was defensible (one has no session to infer from, the
    # other does) but it cost typing errors to whoever reads the surface --
    # including an agent reading SKILL.md, where a wrong command costs a turn.
    # Precedence: --ws > positional > inferred from the tmux session.
    sp = sub.add_parser("up", help="create the workspace session (idempotent)")
    sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--ws"); sp.set_defaults(func=cmd_up)

    sp = sub.add_parser("attach", help="tmux attach to the workspace")
    sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--ws"); sp.set_defaults(func=cmd_attach)

    sp = sub.add_parser("wt", help="worktree: new | rm")
    wt = sp.add_subparsers(dest="wt_cmd", required=True)
    new = wt.add_parser("new", help="create worktree + window, fresh base from origin")
    new.add_argument("target", help="<repo>/<slug>")
    new.add_argument("ws_pos", nargs="?", metavar="ws")
    new.add_argument("--branch", required=True)
    new.add_argument("--base")
    new.add_argument("--ws")
    new.add_argument("--no-fetch", action="store_true")
    new.add_argument("--spawn", metavar="PROVIDER",
                     help="start an agent in the freshly created worktree")
    new.add_argument("--as", dest="as_name", metavar="NAME",
                     help="name for the --spawn agent (default: the slug)")
    new.add_argument("--prompt", help="initial prompt, with --spawn")
    # `wt new --spawn` is the common sequence; without the flag here a
    # coordinator would have to split it into two commands just to get a hook.
    new.add_argument("--parent-exec", dest="parent_exec",
                     help="with --spawn: the command `orq done` runs, "
                          "for a parent that is not a pane")
    new.add_argument("--parent-exec-timeout", dest="parent_exec_timeout",
                     type=float, default=PARENT_EXEC_TIMEOUT)
    new.add_argument("--no-files", action="store_true")
    new.add_argument("--no-hooks", action="store_true")
    new.set_defaults(func=cmd_wt_new)
    rm = wt.add_parser("rm", help="remove worktree and window; never deletes the branch")
    rm.add_argument("target")
    rm.add_argument("ws_pos", nargs="?", metavar="ws")
    rm.add_argument("--ws")
    rm.add_argument("--force", action="store_true")
    rm.set_defaults(func=cmd_wt_rm)

    sp = sub.add_parser("resurrect", help="recreate windows that died")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--ws")
    sp.set_defaults(func=cmd_resurrect)

    sp = sub.add_parser("spawn",
                        help="start a terminal/agent in a worktree; without --wt "
                             "it is born at the workspace root (window _lead)")
    sp.add_argument("name"); sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--wt")
    sp.add_argument("--provider"); sp.add_argument("--cmd", dest="cmd_str")
    sp.add_argument("--prompt"); sp.add_argument("--parent")
    sp.add_argument("--parent-exec", dest="parent_exec",
                    help="shell command `orq done` runs for this agent, with "
                         "the event on stdin -- how a coordinator with no pane "
                         "gets told. Not inherited by panes this one spawns")
    sp.add_argument("--parent-exec-timeout", dest="parent_exec_timeout",
                    type=float, default=PARENT_EXEC_TIMEOUT,
                    help=f"seconds before the hook is given up on "
                         f"(default {PARENT_EXEC_TIMEOUT})")
    sp.add_argument("--split", action="store_true"); sp.add_argument("--ws")
    sp.set_defaults(func=cmd_spawn)

    sp = sub.add_parser("kill",
                        help="kill a pane, by agent name or by pane id (%%12)")
    sp.add_argument("name", metavar="name|%pane")
    sp.set_defaults(func=cmd_kill)

    sp = sub.add_parser("send", help="paste a prompt into the pane")
    sp.add_argument("name"); sp.add_argument("text")
    sp.add_argument("--no-enter", action="store_true")
    sp.set_defaults(func=cmd_send)

    sp = sub.add_parser("keys", help="send named keys")
    sp.add_argument("name"); sp.add_argument("keys", nargs="+")
    sp.set_defaults(func=cmd_keys)

    sp = sub.add_parser("read", help="capture-pane as plain text")
    sp.add_argument("name"); sp.add_argument("--lines", type=int, default=200)
    sp.set_defaults(func=cmd_read)

    sp = sub.add_parser("done", help="close the turn: record status and notify the parent")
    sp.add_argument("msg", nargs="?", default=""); sp.add_argument("--to")
    sp.set_defaults(func=cmd_done)

    sp = sub.add_parser("_status",
                        help="internal: the agent hook reports its own state")
    sp.set_defaults(func=cmd_status_hook)

    sp = sub.add_parser("ls", help="tree: workspace -> worktree -> panes")
    sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--json", action="store_true"); sp.add_argument("--ws")
    sp.set_defaults(func=cmd_ls)

    sp = sub.add_parser("dash", help="Textual dashboard (runs orq-dash)")
    sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--ws")
    sp.set_defaults(func=cmd_dash)

    sp = sub.add_parser("log", help="filter over log.jsonl")
    sp.add_argument("ws_pos", nargs="?", metavar="ws")
    sp.add_argument("--since"); sp.add_argument("--ws"); sp.add_argument("--action")
    sp.set_defaults(func=cmd_log)

    sp = sub.add_parser("schedule", help="add | ls | rm | run")
    sc = sp.add_subparsers(dest="schedule_cmd", required=True)
    add = sc.add_parser("add"); add.add_argument("name")
    add.add_argument("--cron"); add.add_argument("--calendar")
    add.add_argument("--cwd", metavar="PATH",
                     help="directory the job runs in (default: ~)")
    add.add_argument("--desc", metavar="TEXT",
                     help="short human description, shown in the dash")
    # The command comes after `--` and is split off BEFORE argparse (see main).
    # With nargs=REMAINDER here, argparse swallowed orq's own flags: an
    # `add <name> --cron "…"` became command=["--cron", "…"] and --cron was
    # never parsed.
    add.add_argument("command", nargs="*", default=[])
    add.set_defaults(func=cmd_schedule_add)
    sls = sc.add_parser("ls"); sls.add_argument("--json", action="store_true")
    sls.set_defaults(func=cmd_schedule_ls)
    slog = sc.add_parser("log", help="what the last run printed")
    slog.add_argument("name")
    slog.add_argument("--lines", type=int, default=200)
    slog.set_defaults(func=cmd_schedule_log)

    srm = sc.add_parser("rm"); srm.add_argument("name")
    srm.set_defaults(func=cmd_schedule_rm)
    srun = sc.add_parser("run", help="fire now, without waiting for the schedule")
    srun.add_argument("name")
    srun.set_defaults(func=cmd_schedule_run)

    return p


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    # `--` separates the user's command from orq's own arguments. It is kept
    # outside argparse on purpose: inside it, REMAINDER swallows flags.
    rest = None
    if "--" in argv:
        cut = argv.index("--")
        argv, rest = argv[:cut], argv[cut + 1:]
    args = build_parser().parse_args(argv)
    if rest is not None:
        args.command = rest
    try:
        args.func(args)
    except OrqError as e:
        sys.exit(f"orq: {e}")
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
