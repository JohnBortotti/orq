# senao nao esta no registro e o `done` dos workers nao tem pra quem mandar.
# Prefixo `_` pra nunca colidir com <repo>/<slug>.
LEAD_WINDOW = "_lead"

# Shells parados: um pane rodando um destes esta "livre" pro spawn tomar.
SHELLS = {"bash", "zsh", "fish", "sh", "dash", "ksh"}

# Armadilha 5: o prompt so pode ser mandado depois que o agente subiu, senao
