BOOT_TIMEOUT_S = 30
BOOT_POLL_S = 0.25


class OrqError(Exception):
    """Erro esperado: vira mensagem e exit 1, sem traceback."""


# --- infra: processo --------------------------------------------------------

def run(cmd, cwd=None, check=True, capture=True):
    p = subprocess.run(
        cmd, cwd=cwd, check=False, text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )
    if check and p.returncode != 0:
        err = (p.stderr or "").strip() or f"exit {p.returncode}"
        raise OrqError(f"{' '.join(cmd[:3])}…: {err}")
    return p


def tmux(*args, check=True, capture=True):
    """Toda chamada de tmux passa por aqui — e' o que garante o `-L orq`."""
    return run(["tmux", "-L", SOCKET, *args], check=check, capture=capture)


def git(cwd, *args, check=True):
    return run(["git", *args], cwd=cwd, check=check)


# --- infra: config ----------------------------------------------------------

def load_yaml(path, what):
    if not path.exists():
        raise OrqError(f"{what} nao existe: {path}")
    with open(path) as f:
        return yaml.safe_load(f) or {}


def workspace_config(ws):
    if not NAME_RE.match(ws):
        raise OrqError(f"nome de workspace invalido: '{ws}' (esperado {NAME_RE.pattern})")
    # Detalhe #7: workspace inexistente e' erro, nunca cria arquivo de config.
    return load_yaml(WORKSPACES / f"{ws}.yml", f"workspace '{ws}'")


def providers_config():
    if not PROVIDERS.exists():
        return {}
    return load_yaml(PROVIDERS, "providers.yml")


def expand(p):
    return Path(os.path.expanduser(str(p)))


# --- infra: registro e log --------------------------------------------------

def ensure_home():
    for d in (HOME, WORKSPACES, STATE):
        d.mkdir(parents=True, exist_ok=True)


def state_file(ws):
    return STATE / f"{ws}.json"


def read_state(ws):
    f = state_file(ws)
    if not f.exists():
        return {"worktrees": {}, "agents": {}}
    with open(f) as fh:
        return json.load(fh)


def update_state(ws, mutate):
    """Detalhe #4: leitura-modificacao-escrita sob `flock`, com replace atomico.

    O flock protege escritor contra escritor (dois `spawn` simultaneos apagariam
    um ao outro); o os.replace protege leitor contra escritor (ninguem ve JSON
    pela metade). A trava sai sozinha quando o fd fecha ou o processo morre —
    e' por isso que nao existe trava orfa aqui.
    """
    ensure_home()
    f = state_file(ws)
    f.touch(exist_ok=True)
    with open(f, "r+") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        raw = fh.read().strip()
        state = json.loads(raw) if raw else {"worktrees": {}, "agents": {}}
        mutate(state)
        tmp = f.with_suffix(".json.tmp")
        with open(tmp, "w") as t:
            json.dump(state, t, indent=2, ensure_ascii=False)
        os.replace(tmp, f)
    return state


def log_event(**fields):
    """Append-only. Nao usa flock: O_APPEND torna a escrita de linha curta
    atomica no Linux, entao processos concorrentes nao se sobrescrevem."""
    ensure_home()
    fields = {"ts": datetime.now(timezone.utc).astimezone().isoformat(), **fields}
    with open(LOG, "a") as f:
        f.write(json.dumps(fields, ensure_ascii=False) + "\n")


# --- infra: tmux queries ----------------------------------------------------

def session_exists(ws):
    return tmux("has-session", "-t", f"={ws}", check=False).returncode == 0


def pane_procs(pane_pid):
    """Comandos que rodam DENTRO do pane: o processo do proprio pane mais os
    descendentes.

    Existe porque `pane_current_command` mente conforme o pane nasceu. Medido
    em 01/09/2026 com dois Claude identicos na mesma janela: o que TOMOU um
    shell existente (send-keys) reporta `claude`; o que veio de `split-window`
    com o comando reporta `bash`, mesmo tendo `claude` como filho em
    foreground. Isso furava a recusa de "agente vivo" do `wt rm` do segundo
    agente em diante -- a mesma trava que o `-s` do list-panes ja tinha furado.
    """
    if not pane_pid:
        return []
    vistos, fila, saida = set(), [str(pane_pid)], []
    while fila:
        pid = fila.pop()
        if pid in vistos:
            continue
        vistos.add(pid)
        r = run(["ps", "-o", "comm=", "-p", pid], check=False)
        nome = r.stdout.strip()
        if nome:
            saida.append(nome)
        r = run(["ps", "-o", "pid=", "--ppid", pid], check=False)
        fila.extend(x.strip() for x in r.stdout.split() if x.strip())
    return saida


def list_panes(ws=None):
    """Panes vivos no socket do orq, como lista de dicts."""
    fmt = "\t".join([
        "#{session_name}", "#{window_name}", "#{pane_id}",
        "#{pane_current_command}", "#{pane_current_path}",
        "#{window_activity_flag}", "#{window_silence_flag}", "#{pane_pid}",
    ])
    # `-s` e' obrigatorio: sem ele, `-t <sessao>` lista so os panes da janela
    # ATIVA, e nao os da sessao inteira. Isso escondia panes do `ls` e furava
    # a recusa de "agente vivo" do `wt rm`.
    target = ["-s", "-t", f"={ws}"] if ws else ["-a"]
    p = tmux("list-panes", "-F", fmt, *target, check=False)
    if p.returncode != 0:
        return []
    out = []
    for line in p.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 8:
            continue
        d = dict(zip(
            ["session", "window", "pane", "command", "path", "activity",
             "silence", "pid"],
            parts,
        ))
        # `command` vem do tmux e mente conforme o pane nasceu; `procs` e' a
        # verdade da arvore. Quem decide algo olha `procs`.
        d["procs"] = pane_procs(d["pid"])
        out.append(d)
    return out


def window_exists(ws, window):
    return any(p["window"] == window for p in list_panes(ws))


# --- infra: git -------------------------------------------------------------

def default_remote_branch(repo_path):
    p = git(repo_path, "symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False)
    if p.returncode == 0 and p.stdout.strip():
        return p.stdout.strip()                      # ex.: origin/main
    for cand in ("origin/main", "origin/master"):
        if git(repo_path, "rev-parse", "--verify", cand, check=False).returncode == 0:
            return cand
    raise OrqError(
        f"{repo_path}: nao consegui descobrir a branch default do origin. "
        "Rode `git remote set-head origin -a` no repo."
    )


def branch_exists(repo_path, branch):
    return git(repo_path, "show-ref", "--verify", "--quiet",
               f"refs/heads/{branch}", check=False).returncode == 0


def dirty_entries(path, ignore=()):
    """Sujeira real da arvore, descontando o que o proprio orq colocou la.

    Sem isso, `files.symlink` deixa o worktree permanentemente sujo: um padrao
    de .gitignore com barra final (`node_modules/`) casa diretorio, e symlink
    NAO e' diretorio pro git — o link vira `?? node_modules` pra sempre, e o
    `wt rm` passaria a recusar todo worktree. O orq nao mente sobre o estado da
    arvore; ele so nao conta contra o usuario o que ele mesmo criou.
    """
    ignore = set(ignore or ())
    out = []
    for line in git(path, "status", "--porcelain").stdout.splitlines():
        if len(line) < 4:
            continue
        entry = line[3:].strip().strip('"')
        if entry.rstrip("/") in ignore:
            continue
        out.append(entry)
    return out


def git_worktrees(repo_path):
    """Paths e branches que o git conhece, do `worktree list --porcelain`.
    E' a fonte que sobrevive a perda do `~/.orq/state/` — o registro e' indice,
    nao verdade."""
    out, cur = [], {}
    for line in git(repo_path, "worktree", "list", "--porcelain").stdout.splitlines():
        if not line.strip():
            if cur:
                out.append(cur); cur = {}
            continue
        key, _, val = line.partition(" ")
        if key == "worktree":
            cur["path"] = Path(val)
        elif key == "branch":
            cur["branch"] = val.replace("refs/heads/", "")
        elif key == "detached":
            cur["branch"] = None
    if cur:
        out.append(cur)
    return out


def is_dirty(path, ignore=()):
    return bool(dirty_entries(path, ignore))


def unpushed_commits(path, branch):
    p = git(path, "rev-list", branch, "--not", "--remotes", check=False)
    return [c for c in p.stdout.split() if c] if p.returncode == 0 else []


# --- resolucao de alvo ------------------------------------------------------

def split_target(target):
    if target.count("/") < 1:
        raise OrqError(f"alvo invalido: '{target}' (esperado <repo>/<slug>)")
    repo, slug = target.split("/", 1)
    if not NAME_RE.match(target):
        raise OrqError(f"nome invalido: '{target}' (esperado {NAME_RE.pattern})")
    return repo, slug


def ws_arg(args):
    """--ws vence o posicional. Os dois existem em todo comando que aceita
    workspace; a assimetria antiga (posicional obrigatorio em `up`/`attach`,
    so `--ws` no resto) custava erro de digitacao a quem le a superficie."""
    return getattr(args, "ws", None) or getattr(args, "ws_pos", None)


def resolve_ws(explicit):
    """Workspace explicito, ou inferido da sessao tmux atual quando se esta
    dentro do socket do orq.

    O plano nao dizia como inferir; esta leitura rodou o dia 01/09 inteiro sem
    atrito e foi confirmada. Precedencia: explicito > inferido da sessao.
    """
    if explicit:
        return explicit
    if os.environ.get("TMUX"):
        p = tmux("display-message", "-p", "#{session_name}", check=False)
        if p.returncode == 0 and p.stdout.strip():
            return p.stdout.strip()
    raise OrqError("nao consegui inferir o workspace — passe --ws")


def repo_path(cfg, repo):
    repos = cfg.get("repos") or {}
    if repo not in repos:
        conhecidos = ", ".join(sorted(repos)) or "(nenhum)"
        raise OrqError(f"repo '{repo}' nao esta no workspace. Conhecidos: {conhecidos}")
    path = expand(repos[repo])
    if not (path / ".git").exists():
        raise OrqError(f"'{repo}' aponta pra {path}, que nao e' um repo git")
    return path


def worktree_path(cfg, repo, slug):
    root = expand(cfg.get("worktrees") or "~/wt")
    return root / repo / slug


def lead_root(cfg):
    """Onde nasce o agente de nivel de workspace. Default `~` preserva o
    comportamento de quem nao declara `root:`."""
    root = expand(cfg.get("root") or "~")
    if not root.is_dir():
        raise OrqError(f"root '{root}' nao existe ou nao e' diretorio "
                       f"(chave `root:` do workspace)")
    return root


# --- file ops e post_create -------------------------------------------------

def apply_file_ops(cfg, src, dst):
    """Worktree novo e' checkout limpo: sem .env, sem node_modules, e a app nao
    sobe. Copy pro que e' por-worktree, symlink pro que e' pesado."""
    files = (cfg.get("files") or {})
    done = {"copied": [], "linked": []}
    for pattern in files.get("copy") or []:
        for origin in sorted(src.glob(pattern)):
            target = dst / origin.relative_to(src)
            target.parent.mkdir(parents=True, exist_ok=True)
            if origin.is_dir():
                shutil.copytree(origin, target, dirs_exist_ok=True)
            else:
                shutil.copy2(origin, target)
            done["copied"].append(str(origin.relative_to(src)))
    for pattern in files.get("symlink") or []:
        for origin in sorted(src.glob(pattern)):
            target = dst / origin.relative_to(src)
            if target.exists() or target.is_symlink():
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            target.symlink_to(origin)
            done["linked"].append(str(origin.relative_to(src)))
    return done


def run_post_create(cfg, cwd):
    """Roda antes de a janela abrir — e' por isso que instalacao pesada
    (pnpm install) e' melhor num pane: aqui ela bloqueia."""
    for cmd in cfg.get("post_create") or []:
        p = run(["bash", "-lc", cmd], cwd=cwd, check=False, capture=False)
        if p.returncode != 0:
            raise OrqError(f"post_create falhou: {cmd}")


# --- agentes: resolucao e registro ------------------------------------------

def all_pane_ids():
    p = tmux("list-panes", "-a", "-F", "#{pane_id}", check=False)
    return set(p.stdout.split()) if p.returncode == 0 else set()


def find_agent(name):
    """Nome -> (workspace, registro). Detalhe #6: pane morto vira nome orfao, e
    a falha tem que dizer isso, nao 'nao encontrado'."""
    if not WORKSPACES.exists():
        raise OrqError(f"'{name}' nao existe")
    vivos = all_pane_ids()
    for f in sorted(WORKSPACES.glob("*.yml")):
        ws = f.stem
        agents = read_state(ws).get("agents") or {}
        if name in agents:
            reg = agents[name]
            if reg["pane"] not in vivos:
                raise OrqError(
                    f"'{name}' nao existe mais — pane {reg['pane']} morreu. "
                    f"(`orq ls` limpa o registro)"
                )
            return ws, reg
    raise OrqError(f"'{name}' nao existe")


def caller_agent():
    """Quem chamou, via $TMUX_PANE. E' isto que faz o `done` achar o pai sem o
    worker precisar saber o nome de ninguem."""
    pane = os.environ.get("TMUX_PANE")
    if not pane or not WORKSPACES.exists():
        return None
    for f in sorted(WORKSPACES.glob("*.yml")):
        for nome, reg in (read_state(f.stem).get("agents") or {}).items():
            if reg.get("pane") == pane:
                return nome
    return None


def provider_cmd(nome_provider, session_id):
    provs = providers_config()
    if nome_provider not in provs:
        conhecidos = ", ".join(sorted(provs)) or "(nenhum)"
        raise OrqError(f"provider '{nome_provider}' desconhecido. Conhecidos: {conhecidos}")
    entry = provs[nome_provider]
    cmd = entry["cmd"] if isinstance(entry, dict) else str(entry)
    # Detalhe #3: o session_id e' GERADO pelo orq, nao raspado da tela — assim
    # ele e' conhecido antes de o agente subir e o `--resume` ja tem o que
    # precisa. Providers que nao suportam simplesmente nao usam o placeholder.
    cmd = cmd.replace("{session_id}", session_id)
    # Mesmo contrato do {session_id}: e' placeholder na TABELA. Provider que
    # nao tem hook simplesmente nao usa, e cai no fallback de leitura de tela.
    if "{hooks}" in cmd:
        cmd = cmd.replace("{hooks}", shlex.quote(str(hooks_file(nome_provider))))
    return cmd


def hooks_file(provider):
    """Settings de hooks do provider, gerado pelo orq, e devolve o path.

    Fica FORA do settings global do agente de proposito: `claude --settings`
    SOMA em vez de substituir, entao o orq nunca reescreve o
    ~/.claude/settings.json do usuario -- que aqui ja tem seis hooks de outra
    ferramenta -- e o hook so vale pros agentes que o orq subiu.
    """
    HOOKS.mkdir(parents=True, exist_ok=True)
    exe = shlex.quote(str(Path(sys.argv[0]).resolve()))
    # `|| true`: hook que falha nao pode atrapalhar o agente.
    entrada = [{"hooks": [{"type": "command",
                           "command": f"{exe} _status || true",
                           "timeout": 5}]}]
    doc = {"hooks": {ev: entrada for ev in HOOK_STATUS}}
    path = HOOKS / f"{provider}.json"
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(doc, indent=2, ensure_ascii=False))
    os.replace(tmp, path)
    return path


def set_status(ws, nome, status):
    agora = datetime.now(timezone.utc).astimezone().isoformat()

    def mutate(st):
        a = (st.get("agents") or {}).get(nome)
        if a is not None:
            a["status"] = status
            a["status_at"] = agora
    update_state(ws, mutate)


def agent_by(sid, pane):
    """Acha o agente pelo session_id -- que e' identificador do ORQ, nao do
    multiplexer -- caindo pro pane do tmux quando o provider nao o reporta."""
    if not WORKSPACES.exists():
        return None, None
    todos = []
    for f in sorted(WORKSPACES.glob("*.yml")):
        for nome, reg in (read_state(f.stem).get("agents") or {}).items():
            todos.append((f.stem, nome, reg))
    for chave, valor in (("session_id", sid), ("pane", pane)):
        if not valor:
            continue
        for ws, nome, reg in todos:
            if reg.get(chave) == valor:
                return ws, nome
    return None, None


def paste_into(pane, texto, enter=True):
    """Armadilha 4: NAO e' send-keys cru. Prompt com quebra de linha submeteria
    no meio (Enter e' submit no Claude Code) e texto contendo nome de tecla
    seria interpretado. set-buffer + paste-buffer -p (bracketed paste)."""
    buf = f"orq-{uuid.uuid4().hex[:8]}"
    tmux("set-buffer", "-b", buf, "--", texto)
    tmux("paste-buffer", "-d", "-b", buf, "-p", "-t", pane)
    if enter:
        tmux("send-keys", "-t", pane, "Enter")


def wait_for_ready(pane, binario, ready_when, blocked_when):
    """Espera o agente estar PRONTO PRA RECEBER INPUT — nao apenas existir.

    Armadilha 5, corrigida em 31/08 com um Claude real: `pane_current_command`
    vira o provider em milissegundos, mas a TUI so aceita input muito depois.
    Confiar nisso manda o prompt pro vazio — foi o que aconteceu, com o pane
    parado no dialogo de confianca e o orq dizendo "prompt enviado".

    Prontidao e' DADO, nao codigo: cada provider declara `ready_when` e
    `blocked_when` no providers.yml. Agnosticismo aqui e' uma tabela, nao uma
    arquitetura — mesma razao de nao existir interface abstrata de provider.

    Devolve (pronto: bool, motivo: str|None).
    """
    ready_re = re.compile(ready_when, re.M) if ready_when else None
    blocked_re = re.compile(blocked_when, re.M) if blocked_when else None
    limite = time.monotonic() + BOOT_TIMEOUT_S
    tela = ""
    while time.monotonic() < limite:
        # Arvore de processos, nao `pane_current_command`: em pane nascido de
        # split-window o tmux reporta o shell, entao esta porta NUNCA abria e
        # `spawn --split --prompt` estourava os 30s sem sequer olhar a tela.
        # Mesma causa que furava a recusa do `wt rm` e mentia no `ls`.
        p = tmux("display-message", "-p", "-t", pane, "#{pane_pid}", check=False)
        vivo = (p.returncode == 0
                and binario in pane_procs(p.stdout.strip()))
        if vivo:
            c = tmux("capture-pane", "-p", "-t", pane, check=False)
            tela = c.stdout if c.returncode == 0 else ""
            if blocked_re and blocked_re.search(tela):
                achado = blocked_re.search(tela).group(0).strip()
                return False, f"o agente esta bloqueado num dialogo: {achado!r}"
            if ready_re is None or ready_re.search(tela):
                return True, None
        time.sleep(BOOT_POLL_S)
    if not tela:
        return False, f"'{binario}' nao apareceu em {BOOT_TIMEOUT_S}s"
    return False, f"'{binario}' subiu mas nao ficou pronto em {BOOT_TIMEOUT_S}s"


