#!/usr/bin/env python3
"""orq -- an agent orchestrator over tmux, git worktree and systemd.

Single file, no build, readable in an afternoon. All orchestration -- the
graph, the order, who does what -- lives in the skill and in the prompt, never
here.
"""

import argparse
import fcntl
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path

import yaml

# --- constants fixed by the plan --------------------------------------------

# Detail #2: the socket is `-L orq` on EVERY command, not just up/attach.
# Forgetting the flag on one subcommand lands it on the wrong tmux server,
# silently.
SOCKET = "orq"

HOME = Path(os.environ.get("ORQ_HOME", Path.home() / ".orq"))
CONFIG = HOME / "config.yml"
PROVIDERS = HOME / "providers.yml"
WORKSPACES = HOME / "workspaces"
STATE = HOME / "state"
LOG = HOME / "log.jsonl"
HOOKS = HOME / "hooks"
# Where systemd keeps the `Persistent=true` stamp of each timer. `schedule rm`
# has to delete it: leaving it behind makes a NEW schedule that reuses an old
# name report the old run as its `last`, and can make systemd decide a run was
# missed and fire the job the moment it is created.
TIMER_STAMPS = Path.home() / ".local/share/systemd/timers"

# Schedules: the UNIT is the registry. There is no mirror under ~/.orq/ to
# drift -- the unit describes itself and `schedule ls` reads systemd directly.
UNITS = Path(os.environ.get("ORQ_UNITS",
                            Path.home() / ".config/systemd/user"))
SCHED_PREFIX = "orq-"
# Quantity ceiling: an agent creating a recurring job is a different kind of
# power -- it runs later, alone, with bypass, with nobody watching, and it can
# create more. The ugly case is not malice, it is ACCUMULATION.
SCHED_MAX = 32

# Agent event -> status in the registry. ONE command serves them all: the hook
# payload carries `hook_event_name`, so the table lives here instead of turning
# into several different entries in the provider's settings.
#
# `waiting` was CUT on 2026-09-01, after measuring. Claude Code's `Notification`
# fires 60s AFTER Stop, with message="Claude is waiting for your input" -- that
# is, `waiting` was `done` plus a minute, carrying no new information about the
# agent. Worse: it overwrote `done`, and from then on `ls` could no longer tell
# who had FINISHED from who was spawned and never produced anything. In workmux
# `waiting` means "needs the human" (a pending question or permission); with
# --dangerously-skip-permissions that case does not exist here, so the state
# degenerated into a stopwatch. Two states the agent really distinguishes beat
# three where one of them lies.
HOOK_STATUS = {
    "UserPromptSubmit": "working",
    "Stop": "done",
}
# schedules do NOT live here: the systemd unit is the only source of truth.

# Detail #5: `:` and `.` are tmux target separators (session:window.pane), so
# neither is allowed in a workspace, worktree or agent name -- a name with a dot
# would become an ambiguous target in every `-t` in this file.
# Decided this way on 2026-09-01, settling a contradiction in the plan (the
# original character class included `.`, the prose beside it forbade it). The
# cost is cosmetic and known: a repo with a dot in its name (`docs.site`,
# `api.v2`) becomes `docs-site`, `api-v2`. This MUST be in SKILL.md, otherwise
# an agent tries `api.v2` and gets an error it cannot explain.
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_/-]*$")

# The window born with the session, at the workspace's `root:`. Not a worktree:
# it is where the WORKSPACE-LEVEL agent lives -- the orchestrator, which works
# one level above the repos. It has to be born from a `spawn` like any other,
# otherwise it is not in the registry and the workers' `done` has nobody to
# notify. The `_` prefix keeps it from ever colliding with <repo>/<slug>.
LEAD_WINDOW = "_lead"

# Idle shells: a pane running one of these is "free" for spawn to take over.
SHELLS = {"bash", "zsh", "fish", "sh", "dash", "ksh"}

# `done` delivers to a pane. A coordinator running as a background job has no
# pane, so `--parent-exec` gives it a command to be reached by instead. The
# timeout is short and mandatory: a hook that hangs must not hang the worker
# that is only trying to close its turn.
PARENT_EXEC_TIMEOUT = 10

# Pitfall 5: the prompt can only be sent after the agent is up, otherwise it
# lands in the shell. See wait_for_ready -- readiness is data, not code.
BOOT_TIMEOUT_S = 30
BOOT_POLL_S = 0.25


class OrqError(Exception):
    """An expected error: becomes a message and exit 1, with no traceback."""


# --- infra: process ---------------------------------------------------------

def run(cmd, cwd=None, check=True, capture=True, stdin=None):
    p = subprocess.run(
        cmd, cwd=cwd, check=False, text=True, input=stdin,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )
    if check and p.returncode != 0:
        err = (p.stderr or "").strip() or f"exit {p.returncode}"
        raise OrqError(f"{' '.join(cmd[:3])}…: {err}")
    return p


def tmux(*args, check=True, capture=True, stdin=None):
    """Every tmux call goes through here -- that is what guarantees `-L orq`."""
    return run(["tmux", "-L", SOCKET, *args], check=check, capture=capture,
               stdin=stdin)


def git(cwd, *args, check=True):
    return run(["git", *args], cwd=cwd, check=check)


# --- infra: config ----------------------------------------------------------

def load_yaml(path, what):
    if not path.exists():
        raise OrqError(f"{what} does not exist: {path}")
    with open(path) as f:
        return yaml.safe_load(f) or {}


def workspace_config(ws):
    if not NAME_RE.match(ws):
        raise OrqError(f"invalid workspace name: '{ws}' (expected {NAME_RE.pattern})")
    # Detail #7: a missing workspace is an error; never create a config file.
    return load_yaml(WORKSPACES / f"{ws}.yml", f"workspace '{ws}'")


def providers_config():
    if not PROVIDERS.exists():
        return {}
    return load_yaml(PROVIDERS, "providers.yml")


def expand(p):
    return Path(os.path.expanduser(str(p)))


# --- infra: registry and log ------------------------------------------------

def ensure_home():
    for d in (HOME, WORKSPACES, STATE):
        d.mkdir(parents=True, exist_ok=True)


def state_file(ws):
    return STATE / f"{ws}.json"


def read_state(ws):
    f = state_file(ws)
    if not f.exists():
        return {"worktrees": {}, "agents": {}}
    with open(f) as fh:
        return json.load(fh)


def update_state(ws, mutate):
    """Detail #4: read-modify-write under `flock`, with an atomic replace.

    The flock protects writer against writer (two concurrent `spawn`s would
    erase each other); os.replace protects reader against writer (nobody sees
    half a JSON). The lock releases itself when the fd closes or the process
    dies -- which is why there is no orphan lock here.
    """
    ensure_home()
    f = state_file(ws)
    f.touch(exist_ok=True)
    with open(f, "r+") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        raw = fh.read().strip()
        state = json.loads(raw) if raw else {"worktrees": {}, "agents": {}}
        mutate(state)
        tmp = f.with_suffix(".json.tmp")
        with open(tmp, "w") as t:
            json.dump(state, t, indent=2, ensure_ascii=False)
        os.replace(tmp, f)
    return state


def log_event(**fields):
    """Append-only. No flock: O_APPEND makes a short line write atomic on
    Linux, so concurrent processes do not overwrite each other."""
    ensure_home()
    fields = {"ts": datetime.now(timezone.utc).astimezone().isoformat(), **fields}
    with open(LOG, "a") as f:
        f.write(json.dumps(fields, ensure_ascii=False) + "\n")


# --- infra: tmux queries ----------------------------------------------------

def session_exists(ws):
    return tmux("has-session", "-t", f"={ws}", check=False).returncode == 0


def proc_table():
    """The whole process table in a single `ps` call.

    The first version fired TWO calls per PID walked. Measured with 5 panes:
    202ms -- and since `dash` rebuilt everything on every keystroke, that is
    what made it feel stuck."""
    r = run(["ps", "-eo", "pid=,ppid=,comm="], check=False)
    children, names = {}, {}
    for line in r.stdout.splitlines():
        parts = line.split(None, 2)
        if len(parts) != 3:
            continue
        pid, ppid, comm = parts
        names[pid] = comm
        children.setdefault(ppid, []).append(pid)
    return children, names


def pane_procs(pane_pid, table=None):
    """Commands running INSIDE the pane: the pane's own process plus its
    descendants.

    It exists because `pane_current_command` lies depending on how the pane was
    born. Measured on 2026-09-01 with two identical Claudes in the same window:
    the one that TOOK OVER an existing shell (send-keys) reports `claude`; the
    one born from `split-window` with the command reports `bash`, even with
    `claude` as its foreground child. That defeated the "live agent" refusal in
    `wt rm` from the second agent on -- the same guard the missing `-s` on
    list-panes had already defeated.
    """
    if not pane_pid:
        return []
    children, names = table if table else proc_table()
    seen, queue, out = set(), [str(pane_pid)], []
    while queue:
        pid = queue.pop()
        if pid in seen:
            continue
        seen.add(pid)
        if pid in names:
            out.append(names[pid])
        queue.extend(children.get(pid, []))
    return out


def list_panes(ws=None):
    """Panes alive no socket do orq, como lista de dicts."""
    fmt = "\t".join([
        "#{session_name}", "#{window_name}", "#{pane_id}",
        "#{pane_current_command}", "#{pane_current_path}",
        "#{window_activity_flag}", "#{window_silence_flag}", "#{pane_pid}",
    ])
    # `-s` is mandatory: without it, `-t <session>` lists only the panes of the
    # ACTIVE window, not the whole session. That hid panes from `ls` and
    # defeated the "agent alive" refusal in `wt rm`.
    target = ["-s", "-t", f"={ws}"] if ws else ["-a"]
    p = tmux("list-panes", "-F", fmt, *target, check=False)
    if p.returncode != 0:
        return []
    out = []
    table = proc_table()          # once per listing, not once per pane
    for line in p.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 8:
            continue
        d = dict(zip(
            ["session", "window", "pane", "command", "path", "activity",
             "silence", "pid"],
            parts,
        ))
        # `command` comes from tmux and lies depending on how the pane was
        # born; `procs` is the truth from the process tree. Anything that
        # DECIDES something reads `procs`.
        d["procs"] = pane_procs(d["pid"], table)
        out.append(d)
    return out


def window_exists(ws, window):
    return any(p["window"] == window for p in list_panes(ws))


# --- infra: git -------------------------------------------------------------

def default_remote_branch(repo_path):
    p = git(repo_path, "symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False)
    if p.returncode == 0 and p.stdout.strip():
        return p.stdout.strip()                      # ex.: origin/main
    for cand in ("origin/main", "origin/master"):
        if git(repo_path, "rev-parse", "--verify", cand, check=False).returncode == 0:
            return cand
    raise OrqError(
        f"{repo_path}: could not determine origin's default branch. "
        "Run `git remote set-head origin -a` in the repo."
    )


def branch_exists(repo_path, branch):
    return git(repo_path, "show-ref", "--verify", "--quiet",
               f"refs/heads/{branch}", check=False).returncode == 0


def dirty_entries(path, ignore=()):
    """Real dirt in the tree, discounting what orq itself put there.

    Without this, `files.symlink` leaves the worktree permanently dirty: a
    .gitignore pattern with a trailing slash (`node_modules/`) matches a
    directory, and a symlink is NOT a directory to git -- the link becomes
    `?? node_modules` forever, and `wt rm` would start refusing every worktree.
    orq does not lie about the state of the tree; it just does not count
    against the user what it put there itself.
    """
    ignore = set(ignore or ())
    out = []
    for line in git(path, "status", "--porcelain").stdout.splitlines():
        if len(line) < 4:
            continue
        entry = line[3:].strip().strip('"')
        if entry.rstrip("/") in ignore:
            continue
        out.append(entry)
    return out


def git_worktrees(repo_path):
    """Paths and branches git knows about, from `worktree list --porcelain`.
    It is the source that survives losing `~/.orq/state/` -- the registry is an
    index, not the truth."""
    out, cur = [], {}
    for line in git(repo_path, "worktree", "list", "--porcelain").stdout.splitlines():
        if not line.strip():
            if cur:
                out.append(cur); cur = {}
            continue
        key, _, val = line.partition(" ")
        if key == "worktree":
            cur["path"] = Path(val)
        elif key == "branch":
            cur["branch"] = val.replace("refs/heads/", "")
        elif key == "detached":
            cur["branch"] = None
    if cur:
        out.append(cur)
    return out


def is_dirty(path, ignore=()):
    return bool(dirty_entries(path, ignore))


def unpushed_commits(path, branch):
    p = git(path, "rev-list", branch, "--not", "--remotes", check=False)
    return [c for c in p.stdout.split() if c] if p.returncode == 0 else []


# --- target resolution ------------------------------------------------------

def split_target(target):
    if target.count("/") < 1:
        raise OrqError(f"target invalido: '{target}' (esperado <repo>/<slug>)")
    repo, slug = target.split("/", 1)
    if not NAME_RE.match(target):
        raise OrqError(f"invalid name: '{target}' (expected {NAME_RE.pattern})")
    return repo, slug


def ws_arg(args):
    """--ws beats the positional. Both exist on every command that takes a
    workspace; the old asymmetry (positional required by `up`/`attach`, only
    `--ws` on the rest) cost typing errors to whoever reads the surface."""
    return getattr(args, "ws", None) or getattr(args, "ws_pos", None)


def resolve_ws(explicit):
    """The explicit workspace, or the one inferred from the current tmux
    session when running inside orq's socket.

    The plan did not say how to infer it; this reading ran the whole of
    2026-09-01 without friction and was confirmed. Precedence: explicit over
    inferred.
    """
    if explicit:
        return explicit
    if os.environ.get("TMUX"):
        p = tmux("display-message", "-p", "#{session_name}", check=False)
        if p.returncode == 0 and p.stdout.strip():
            return p.stdout.strip()
    raise OrqError("could not infer the workspace -- pass --ws")


def repo_path(cfg, repo):
    repos = cfg.get("repos") or {}
    if repo not in repos:
        known = ", ".join(sorted(repos)) or "(nenhum)"
        raise OrqError(f"repo '{repo}' is not in this workspace. Known: {known}")
    path = expand(repos[repo])
    if not (path / ".git").exists():
        raise OrqError(f"'{repo}' points at {path}, which is not a git repo")
    return path


def worktree_path(cfg, repo, slug):
    root = expand(cfg.get("worktrees") or "~/wt")
    return root / repo / slug


def lead_root(cfg):
    """Where the workspace-level agent is born. The `~` default preserves the
    behaviour of a workspace that declares no `root:`."""
    root = expand(cfg.get("root") or "~")
    if not root.is_dir():
        raise OrqError(f"root '{root}' does not exist or is not a directory "
                       f"(the workspace's `root:` key)")
    return root


# --- file ops e post_create -------------------------------------------------

def apply_file_ops(cfg, src, dst):
    """A new worktree is a clean checkout: no .env, no node_modules, and the app
    will not start. Copy what is per-worktree, symlink what is heavy."""
    files = (cfg.get("files") or {})
    done = {"copied": [], "linked": []}
    for pattern in files.get("copy") or []:
        for origin in sorted(src.glob(pattern)):
            target = dst / origin.relative_to(src)
            target.parent.mkdir(parents=True, exist_ok=True)
            if origin.is_dir():
                shutil.copytree(origin, target, dirs_exist_ok=True)
            else:
                shutil.copy2(origin, target)
            done["copied"].append(str(origin.relative_to(src)))
    for pattern in files.get("symlink") or []:
        for origin in sorted(src.glob(pattern)):
            target = dst / origin.relative_to(src)
            if target.exists() or target.is_symlink():
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            target.symlink_to(origin)
            done["linked"].append(str(origin.relative_to(src)))
    return done


def run_post_create(cfg, cwd):
    """Runs before the window opens -- which is why a heavy install (pnpm
    install) is better off in a pane: here it blocks."""
    for cmd in cfg.get("post_create") or []:
        p = run(["bash", "-lc", cmd], cwd=cwd, check=False, capture=False)
        if p.returncode != 0:
            raise OrqError(f"post_create failed: {cmd}")


# --- agents: resolution and registry ----------------------------------------

def all_pane_ids():
    p = tmux("list-panes", "-a", "-F", "#{pane_id}", check=False)
    return set(p.stdout.split()) if p.returncode == 0 else set()


def find_agent(name):
    """Name -> (workspace, registry entry). Detail #6: a dead pane leaves an
    orphan name, and the failure has to say so, not 'not found'."""
    if not WORKSPACES.exists():
        raise OrqError(f"'{name}' does not exist")
    alive = all_pane_ids()
    for f in sorted(WORKSPACES.glob("*.yml")):
        ws = f.stem
        agents = read_state(ws).get("agents") or {}
        if name in agents:
            reg = agents[name]
            if reg["pane"] not in alive:
                raise OrqError(
                    f"'{name}' no longer exists -- pane {reg['pane']} died. "
                    f"(`orq ls` prunes the registry)"
                )
            return ws, reg
    raise OrqError(f"'{name}' does not exist")


def caller_agent():
    """Who called, via $TMUX_PANE. This is what lets `done` find the parent
    without the worker having to know anybody's name."""
    pane = os.environ.get("TMUX_PANE")
    if not pane or not WORKSPACES.exists():
        return None
    for f in sorted(WORKSPACES.glob("*.yml")):
        for name, reg in (read_state(f.stem).get("agents") or {}).items():
            if reg.get("pane") == pane:
                return name
    return None


def provider_cmd(nome_provider, session_id, mcp=None):
    provs = providers_config()
    if nome_provider not in provs:
        known = ", ".join(sorted(provs)) or "(nenhum)"
        raise OrqError(f"unknown provider '{nome_provider}'. Known: {known}")
    entry = provs[nome_provider]
    cmd = entry["cmd"] if isinstance(entry, dict) else str(entry)
    # Detail #3: the session_id is GENERATED by orq, not scraped off the
    # screen -- so it is known before the agent starts and `--resume` already
    # has what it needs. Providers that do not support it simply leave the
    # placeholder out.
    cmd = cmd.replace("{session_id}", session_id)
    # Same contract as {session_id}: it is a placeholder in the TABLE. A
    # provider with no hook simply leaves it out and falls back to reading the
    # screen.
    if "{hooks}" in cmd:
        cmd = cmd.replace("{hooks}", shlex.quote(str(hooks_file(nome_provider))))
    # Same contract once more, and the reason it has to exist: providers scope
    # their MCP servers BY PROJECT PATH, and a worktree is a path the user has
    # never configured -- so an agent born in `~/wt/api/fc660` sees none of the
    # servers the lead sees in `~/workspace/forest`. The workspace's `mcp:`
    # files are what carry them across.
    if "{mcp}" in cmd:
        flag = mcp_flag(mcp)
        cmd = (cmd.replace(" {mcp}", f" {flag}" if flag else "")
                  .replace("{mcp}", flag))
    return cmd


def mcp_flag(mcp):
    """`--mcp-config` for the workspace's MCP files -- nothing when it has none.

    The files are the provider's own format and are read by the provider, never
    by orq: this stays a table, like providers.yml. They live outside the repos
    on purpose, because an MCP entry commonly carries a token.
    """
    if not mcp:
        return ""
    paths = [mcp] if isinstance(mcp, str) else list(mcp)
    out = []
    for p in paths:
        path = expand(p)
        if not path.exists():
            raise OrqError(f"mcp file does not exist: {path}")
        out.append(shlex.quote(str(path)))
    return "--mcp-config " + " ".join(out)


def hooks_file(provider):
    """Writes the provider's hook settings and returns the path.

    It lives OUTSIDE the agent's global settings on purpose: `claude --settings`
    ADDS rather than replaces, so orq never rewrites the user's
    ~/.claude/settings.json -- which here already carries six hooks from another
    tool -- and the hook only applies to agents orq itself started.
    """
    HOOKS.mkdir(parents=True, exist_ok=True)
    exe = shlex.quote(str(Path(sys.argv[0]).resolve()))
    # `|| true`: a failing hook must never disturb the agent.
    entrada = [{"hooks": [{"type": "command",
                           "command": f"{exe} _status || true",
                           "timeout": 5}]}]
    doc = {"hooks": {ev: entrada for ev in HOOK_STATUS}}
    path = HOOKS / f"{provider}.json"
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(doc, indent=2, ensure_ascii=False))
    os.replace(tmp, path)
    return path


def set_status(ws, name, status):
    agora = datetime.now(timezone.utc).astimezone().isoformat()

    def mutate(st):
        a = (st.get("agents") or {}).get(name)
        if a is not None:
            a["status"] = status
            a["status_at"] = agora
    update_state(ws, mutate)


def agent_by(sid, pane):
    """Finds the agent by session_id -- which is ORQ's identifier, not the
    multiplexer's -- falling back to the tmux pane when the provider does not
    report one."""
    if not WORKSPACES.exists():
        return None, None
    all_regs = []
    for f in sorted(WORKSPACES.glob("*.yml")):
        for name, reg in (read_state(f.stem).get("agents") or {}).items():
            all_regs.append((f.stem, name, reg))
    for chave, valor in (("session_id", sid), ("pane", pane)):
        if not valor:
            continue
        for ws, name, reg in all_regs:
            if reg.get(chave) == valor:
                return ws, name
    return None, None


def paste_into(pane, text, enter=True):
    """Pitfall 4: NOT raw send-keys. A prompt with a line break would submit
    halfway through (Enter is submit in Claude Code) and text containing a key
    name would be interpreted. Buffer + paste-buffer -p (bracketed paste).

    Pitfall 4(b), measured on 2026-09-08: the buffer is filled through STDIN,
    not as an argument. `set-buffer -- <text>` puts the whole prompt in a tmux
    command, and tmux caps a command around 16 KB -- a long prompt failed with
    no useful error. `load-buffer -` reads the same bytes from stdin and took
    1 MB without complaining."""
    buf = f"orq-{uuid.uuid4().hex[:8]}"
    tmux("load-buffer", "-b", buf, "-", stdin=text)
    tmux("paste-buffer", "-d", "-b", buf, "-p", "-t", pane)
    if enter:
        tmux("send-keys", "-t", pane, "Enter")


def wait_for_ready(pane, binary, ready_when, blocked_when):
    """Waits for the agent to be READY TO ACCEPT INPUT -- not merely to exist.

    Pitfall 5, fixed on 2026-08-31 against a real Claude:
    `pane_current_command` becomes the provider within milliseconds, but the TUI
    only accepts input much later. Trusting it sends the prompt into the void --
    which is exactly what happened, with the pane sitting on the trust dialog
    and orq reporting "prompt sent".

    Readiness is DATA, not code: each provider declares `ready_when` and
    `blocked_when` in providers.yml. Agnosticism here is a table, not an
    architecture -- the same reason there is no abstract provider interface.

    Returns (ready: bool, reason: str|None).
    """
    ready_re = re.compile(ready_when, re.M) if ready_when else None
    blocked_re = re.compile(blocked_when, re.M) if blocked_when else None
    deadline = time.monotonic() + BOOT_TIMEOUT_S
    screen = ""
    while time.monotonic() < deadline:
        # Process tree, not `pane_current_command`: in a pane born from
        # split-window tmux reports the shell, so this gate NEVER opened and
        # `spawn --split --prompt` blew the 30s without even looking at the
        # screen. Same cause that defeated the `wt rm` refusal and lied in `ls`.
        p = tmux("display-message", "-p", "-t", pane, "#{pane_pid}", check=False)
        vivo = (p.returncode == 0
                and binary in pane_procs(p.stdout.strip()))
        if vivo:
            c = tmux("capture-pane", "-p", "-t", pane, check=False)
            screen = c.stdout if c.returncode == 0 else ""
            if blocked_re and blocked_re.search(screen):
                found = blocked_re.search(screen).group(0).strip()
                return False, f"the agent is stuck on a dialog: {found!r}"
            if ready_re is None or ready_re.search(screen):
                return True, None
        time.sleep(BOOT_POLL_S)
    if not screen:
        return False, f"'{binary}' did not appear within {BOOT_TIMEOUT_S}s"
    return False, f"'{binary}' started but was not ready within {BOOT_TIMEOUT_S}s"


