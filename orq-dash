#!/home/joao/workspace/orq/.venv/bin/python
"""orq-dash -- a Textual dashboard over `orq`.

A SEPARATE program on purpose. It talks to orq only through the CLI contract
(`orq ls --json`, `orq schedule ls --json`, `orq read`), so it knows nothing
about tmux, systemd or the registry. If this breaks, the orchestrator does
not: `orq` itself stays single-file, stdlib plus PyYAML, and never imports
anything from here.

Where the line sits: the dashboard operates on ORQ OBJECTS -- panes,
worktrees, schedules. Selecting a row and acting on it is less friction than
typing the target's name into a shell. It never becomes a chat client: there
is no box for talking to an agent, because the agent's real interface is its
pane, with its own autocomplete, file references and modes. A textarea that
pastes text loses all of that and duplicates the conversation surface.

Destructive actions always confirm, and `--force` is deliberately absent --
the refusals in `orq wt rm` are the safety net, and a shortcut that skips them
would undo it.
"""

import json
import subprocess

from rich.markup import escape
from rich.text import Text
from datetime import datetime, timezone

from textual import work
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Horizontal, Vertical
from textual.reactive import reactive
from textual.screen import ModalScreen
from textual.theme import Theme
from textual.widgets import (Button, DataTable, Footer, Header, Input,
                             Label, Static, TabbedContent, TabPane)

REFRESH_S = 2.0
PREVIEW_LINES = 60

# Textual ships 21 themes. A dashboard you glance at all day wants ONE
# decision -- dark or light -- not a gallery: every extra entry is noise in the
# command palette and one more way the status colours drift from what they
# were designed against. Both are defined here rather than picked from the
# built-ins, so the two read as the same product.
# ⚠️ No `background`, `surface` or `foreground`: those are left to the
# TERMINAL. Painting our own meant a light terminal got a dark rectangle
# stamped on it (and the reverse), which is exactly the "app that ignores
# where it is running" look. Only the accents are ours -- they are what makes
# the two read as the same product -- and the CSS keeps every container
# transparent so the terminal's own background shows through.
# Every colour is an ANSI slot, not a hex: the point is to look native in
# WHATEVER terminal this runs in, and a hand-picked hex only looks right
# against the background it was picked for -- which we no longer own.
# The light/dark toggle is what makes the choice meaningful again: normal
# ANSI variants read on a light terminal, bright ones on a dark terminal.
# Truecolor with our own background, which is what Posting, Harlequin and
# Toolong all do. Measured trade-off: inheriting the terminal's background
# forces `ansi_color`, which quantises everything to sixteen colours -- and
# sixteen colours IS the Turbo Vision look. It also removes the one device
# that replaces borders in a modern TUI: translucent surface layers.
# Light is PURE WHITE on purpose: it matches the macOS Terminal profile this
# runs in, so the app is not a grey card sitting on a white desktop.
ORQ_LIGHT = Theme(
    name="orq-light", dark=False,
    background="#ffffff", surface="#f4f5f8", panel="#e9ebf1",
    foreground="#1c2333", primary="#4263eb", secondary="#7950f2",
    accent="#0ca678", success="#2f9e44", warning="#f08c00", error="#e03131",
)
ORQ_DARK = Theme(
    name="orq-dark", dark=True,
    background="#12141c", surface="#181b25", panel="#212533",
    foreground="#cdd3e0", primary="#748ffc", secondary="#b197fc",
    accent="#38d9a9", success="#69db7c", warning="#ffd43b", error="#ff8787",
)

# The same slots, for the Rich markup inside table cells -- which cannot read
# Textual's CSS variables. Rebuilt whenever the theme changes so the cells and
# the chrome never drift apart.
PAL = {}


def set_palette(dark):
    """Hex, not ANSI slots: with our own background we know exactly what these
    sit on, so they can be tuned instead of quantised to sixteen."""
    if dark:
        PAL.update({"struct": "#748ffc", "work": "#ffd43b", "ok": "#69db7c",
                    "bad": "#ff8787", "warn": "#ffd43b", "sched": "#b197fc",
                    "muted": "#7d8598", "faint": "#4b5262"})
    else:
        PAL.update({"struct": "#4263eb", "work": "#e8590c", "ok": "#2f9e44",
                    "bad": "#e03131", "warn": "#e8590c", "sched": "#7950f2",
                    "muted": "#7b8296", "faint": "#c2c7d2"})


set_palette(dark=False)
# Light first: it is what he works in.
THEMES = ("orq-light", "orq-dark")


# --- talking to orq ----------------------------------------------------------

def orq(*args, timeout=10):
    """Every call to orq goes through here. Never raises: a dashboard that
    crashes because a subcommand failed is worse than one showing stale rows."""
    try:
        p = subprocess.run(["orq", *args], capture_output=True, text=True,
                           timeout=timeout)
        return p.returncode, p.stdout, p.stderr.strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 1, "", str(e)


def orq_json(*args):
    code, out, err = orq(*args)
    if code != 0:
        return None, err
    try:
        return json.loads(out or "null"), None
    except json.JSONDecodeError as e:
        return None, f"invalid JSON from orq: {e}"


def age_since(iso):
    """'12m', '3h', '2d' -- how a stuck agent becomes visible."""
    if not iso:
        return ""
    try:
        delta = datetime.now(timezone.utc) - datetime.fromisoformat(iso).astimezone(timezone.utc)
    except ValueError:
        return ""
    secs = int(delta.total_seconds())
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m"
    if secs < 86400:
        return f"{secs // 3600}h"
    return f"{secs // 86400}d"


def when_short(ts):
    """`Wed 2026-09-02 08:03:00 -03` -> `wed 08:03`, `today 19:03` when today."""
    if not ts or ts == "-":
        return "-"
    try:
        d = datetime.strptime(" ".join(ts.split()[:3]), "%a %Y-%m-%d %H:%M:%S")
    except ValueError:
        return ts[:16]
    days = (d.date() - datetime.now().date()).days
    label = {0: "today", 1: "tomorrow"}.get(
        days, ["mon", "tue", "wed", "thu", "fri", "sat", "sun"][d.weekday()])
    return f"{label} {d:%H:%M}"


def until(ts):
    """`in 3h`, `in 12m`, `overdue`. A schedule is judged by PROXIMITY, not by
    a timestamp: "today 06:00" makes you do the arithmetic, "in 3h" does not.
    """
    if not ts or ts == "-":
        return "—"
    try:
        d = datetime.strptime(" ".join(ts.split()[:3]), "%a %Y-%m-%d %H:%M:%S")
    except ValueError:
        return ts[:16]
    secs = int((d - datetime.now()).total_seconds())
    if secs < 0:
        return "overdue"
    if secs < 90:
        return "now"
    if secs < 3600:
        return f"in {secs // 60}m"
    if secs < 86400:
        return f"in {secs // 3600}h"
    return f"in {secs // 86400}d"


def ago(ts):
    """`2h ago`, or `never`."""
    if not ts or ts == "-":
        return "never"
    try:
        d = datetime.strptime(" ".join(ts.split()[:3]), "%a %Y-%m-%d %H:%M:%S")
    except ValueError:
        return ts[:16]
    secs = int((datetime.now() - d).total_seconds())
    if secs < 0:
        return "—"
    if secs < 90:
        return "just now"
    if secs < 3600:
        return f"{secs // 60}m ago"
    if secs < 86400:
        return f"{secs // 3600}h ago"
    return f"{secs // 86400}d ago"


def sched_cmd(execstart):
    """`/bin/bash -lc 'cmd'` -> `cmd`."""
    if not execstart:
        return ""
    import shlex
    try:
        parts = shlex.split(execstart)
    except ValueError:
        return execstart
    return parts[-1] if parts else execstart


def line(left, right, width):
    """One column, padded to the real width, so metadata hugs the right edge.

    Two DataTable columns cannot do this: the second one auto-sizes to its
    content and the pair never fills the pane, so the annotation ended up
    floating in the middle -- or off-screen entirely. Building the line by
    hand is both simpler and exact."""
    l = Text.from_markup(left or "")
    r = Text.from_markup(right or "")
    gap = max(1, width - l.cell_len - r.cell_len)
    l.append(" " * gap)
    l.append_text(r)
    return l


# --- rows --------------------------------------------------------------------

class Row:
    """One line in the table, plus everything an action needs to run without
    the user typing a name."""

    def __init__(self, kind, cells, *, agent=None, worktree=None, schedule=None,
                 ws=None, target=None, status=None, detail=None):
        self.kind = kind          # "pane" | "worktree" | "schedule"
        self.cells = cells
        self.agent = agent
        self.worktree = worktree
        self.schedule = schedule
        self.ws = ws
        self.target = target      # session:window.pane, for switch-client
        self.status = status
        self.detail = detail      # raw JSON, for the on-demand card

    @property
    def label(self):
        return self.agent or self.worktree or self.schedule or "?"


def collect(ws_filter=None):
    """Builds every row from the CLI contract. Returns (rows, error).

    Three kinds of thing live in one table, and until 2026-09-02 they all
    looked alike: with four workspaces on screen there were four identical
    `_lead` lines and nothing saying which was whose. Each level now gets its
    own glyph and indent, and the legend above the table spells them out --
    the hierarchy has to be readable without knowing orq's vocabulary.
    """
    args = ["ls", "--json"] + (["--ws", ws_filter] if ws_filter else [])
    data, err = orq_json(*args)
    if err:
        return [], err
    rows = []
    for w in (data or {}).get("workspaces", []):
        session = w["session"]
        alive = w["session_alive"]
        panes_all = [p for wt in w["worktrees"] for p in wt["panes"]] + w["lead"]["panes"]
        agents = sum(1 for p in panes_all if p.get("name"))
        working = sum(1 for p in panes_all if p.get("status") == "working")
        # Only say something when it is NOT the normal case: "alive" on every
        # row is noise, and the column is the one that keeps getting cut.
        state = "" if alive else f"[bold {PAL['bad']}]SESSION DEAD · [/]"
        busy = (f"[{PAL['work']}]{working} working[/]" if working
                else f"[{PAL['faint']}]idle[/]")
        rows.append(Row("spacer", ["", ""]))
        rows.append(Row(
            "workspace",
            [f"[bold {PAL['struct']}]{w['workspace']}[/]",
             f"{state}[{PAL['muted']}]{agents} agents[/]   {busy}"],
            ws=w["workspace"]))

        groups = [(w["lead"]["window"], None, w["lead"]["panes"],
                   f"root {w['lead']['root']}", None)]
        for wt in w["worktrees"]:
            notes = []
            if wt["exists"] is False:
                notes.append(f"[{PAL['bad']}]path gone[/]")
            elif not wt["window_alive"]:
                notes.append(f"[{PAL['warn']}]no window[/]")
            if wt["dirty"]:
                notes.append(f"[{PAL['warn']}]dirty[/]")
            groups.append((wt["worktree"], wt["branch"], wt["panes"],
                           " · ".join(notes), wt["worktree"]))
        for window, branch, panes, note, wt_name in groups:
            rows.append(Row(
                "worktree",
                [f"  [{PAL['muted']}]{window}[/]"
                 + (f"   [{PAL['faint']}]{branch}[/]" if branch else ""),
                 note],
                worktree=wt_name, ws=w["workspace"]))
            for p in panes:
                st = p.get("status") or ""
                # The NAME carries the state, not just the state column: the
                # eye lands on the name first, and a wall of identical names
                # was what made four workspaces unreadable.
                color = {"working": PAL["work"], "done": PAL["ok"]}.get(st, "")
                dot = color or PAL["faint"]
                if not p["name"]:
                    left = f"    [{PAL['faint']}]·   free pane[/]"
                else:
                    strong = "bold " if st == "working" else ""
                    left = (f"    [{dot}]•[/]   "
                            f"[{strong}{color or PAL['muted']}]{p['name']}[/]")
                bits = [f"[{PAL['faint']}]{p['command']}[/]"]
                if st:
                    bits.append(f"[{color}]{st}[/] "
                                f"[{PAL['faint']}]{age_since(p.get('status_at'))}[/]")
                if p.get("parent"):
                    bits.append(f"[{PAL['faint']}]← {p['parent']}[/]")
                rows.append(Row(
                    "pane", [left, "   ".join(bits)],
                    agent=p["name"], ws=w["workspace"],
                    target=f"{session}:{window}.{p['pane']}" if alive else None,
                    status=st))

    return rows, None


def collect_schedules():
    """Schedules get their own table, with their own columns.

    A pane is something you WATCH; a schedule is something you AUDIT. The
    questions are different -- is it healthy, when does it fire, what does it
    do, why did it fail -- and forcing both into one grid is what produced
    both the truncated columns and the hierarchy nobody could read.
    """
    scheds, err = orq_json("schedule", "ls", "--json")
    rows = []
    for s in (scheds or []):
        res = s.get("result") or "-"
        failed = res not in ("ok", "-")
        never = res == "-"
        # A failing schedule has to be impossible to miss: the NAME goes red,
        # not just a cell at the far right.
        dot = PAL["bad"] if failed else PAL["ok"] if res == "ok" else PAL["faint"]
        name = (f"  [{dot}]•[/]   [{'bold ' if failed else ''}{PAL['sched']}]"
                f"{s['name']}[/]")
        nxt = until(s.get("next"))
        nxt_c = (f"bold {PAL['work']}" if nxt in ("now", "overdue")
                 else PAL["muted"])
        result = (f"[bold {PAL['bad']}]failed[/]" if failed
                  else f"[{PAL['ok']}]ok[/]" if res == "ok"
                  else f"[{PAL['muted']}]never ran[/]")
        # Three columns, and the third is EMPTY unless something is wrong.
        # The glance question is "is any of these broken?" -- `never ran`
        # repeated down a column answers nothing and costs attention.
        health = f"[bold {PAL['bad']}]failed[/]" if failed else ""
        right = f"[{nxt_c}]{nxt}[/]" + (f"   {health}" if health else "")
        rows.append(Row("schedule", [name, right],
                        schedule=s["name"], status=res, detail=s))
    return rows, err


# --- confirmation ------------------------------------------------------------

class Confirm(ModalScreen[bool]):
    """Every destructive action goes through here. There is no --force path:
    the refusals inside `orq wt rm` are the safety net, and a shortcut that
    skipped them would undo the work that built them."""

    BINDINGS = [Binding("escape", "dismiss(False)", "cancel"),
                Binding("y", "yes", "confirm")]

    def __init__(self, question):
        super().__init__()
        self.question = question

    def compose(self) -> ComposeResult:
        with Vertical(id="confirm-box"):
            yield Label(self.question, id="confirm-text")
            yield Label("[bright_black]y to confirm · esc to cancel[/bright_black]")

    def action_yes(self):
        self.dismiss(True)


# --- the app -----------------------------------------------------------------

class OrqDash(App):
    CSS = """
    /* No boxes. Sections separate by SPACE and by translucent surface layers,
       the way Posting and Harlequin do it -- a drawn rectangle around every
       region is the Turbo Vision look, not a modern one. Borders appear only
       to mark focus. */
    Screen { layout: vertical; background: $background; }
    #body { height: 1fr; padding: 0 2; }

    #left  { width: 1fr; }
    #right {
        width: 1fr; margin-left: 2; padding: 0 1;
        background: $surface; border: none;
    }
    #right.hidden { display: none; }

    TabbedContent { height: 1fr; }
    TabPane { padding: 1 0 0 0; }
    Tabs { height: 2; }
    Tab { padding: 0 2; color: $text-muted; }
    Tab.-active { color: $primary; text-style: bold; }
    Underline > .underline--bar { color: $primary; background: $panel; }

    DataTable {
        height: 1fr; background: transparent; border: none; padding: 0;
        /* No visible scrollbar: it was a permanent vertical stripe down the
           list. Scrolling still happens -- the cursor drags the view with it
           -- it just stops advertising itself. */
        scrollbar-size: 0 0;
    }
    /* A left accent bar for the selected row instead of a full-width inverse
       block: it marks position without shouting. */
    DataTable > .datatable--cursor { background: $primary 12%; }
    DataTable:focus > .datatable--cursor { background: $primary 20%; }

    #preview-head { height: 1; padding: 0 0 0 1; }
    #preview-title { width: 1fr; color: $accent; text-style: bold; }
    #preview-toggle {
        min-width: 6; width: auto; height: 1; padding: 0 1;
        border: none; background: transparent; color: $text-muted;
    }
    #preview-toggle:hover { color: $primary; text-style: bold; }
    /* `1fr` so the empty state has vertical room to centre in; the class is
       only on while the placeholder is showing, because real preview content
       has to start at the top left. */
    #preview { padding: 1 1 0 1; height: 1fr; }
    #preview.empty { content-align: center middle; text-align: center; }

    #sched-title { padding: 0 0 1 0; }
    #filter, #prompt { display: none; dock: bottom; margin: 0 2;
                       border: none; background: $panel; }
    #filter.on, #prompt.on { display: block; }
    #prompt { border-left: wide $accent; }
    #status { dock: bottom; height: 1; padding: 0 2; color: $text-muted; }

    Header { background: $background; color: $foreground; }
    HeaderTitle { text-style: bold; color: $foreground; }
    Footer { background: $background; }
    FooterKey { background: $background; color: $text-muted; }
    FooterKey > .footer-key--key { color: $primary; text-style: bold; }

    * {
        scrollbar-background: transparent;
        scrollbar-background-hover: transparent;
        scrollbar-background-active: transparent;
        scrollbar-color: $primary 25%;
        scrollbar-color-hover: $primary 45%;
        scrollbar-color-active: $primary 65%;
        scrollbar-corner-color: transparent;
    }

    #confirm-box {
        width: 64; height: auto; padding: 1 2;
        background: $panel; border: none; border-left: wide $warning;
    }
    Confirm { align: center middle; }
    """

    BINDINGS = [
        Binding("q", "quit", "quit"),
        Binding("enter", "switch", "open pane"),
        # "kill pane" is what it does -- the pane dies and the registry entry
        # goes with it. It still only accepts a REGISTERED agent, so a free
        # pane says so instead of silently doing nothing.
        Binding("k", "kill", "kill pane"),
        Binding("d", "wt_rm", "rm worktree"),
        Binding("x", "sched_rm", "remove"),
        Binding("f", "sched_run", "run now"),
        Binding("R", "resurrect", "resurrect"),
        Binding("slash", "filter", "filter"),
        Binding("escape", "clear_filter", "clear filter", show=False),
        Binding("r", "refresh", "refresh"),
        Binding("t", "theme", "dark/light"),
        # NOT `tab`: Textual reserves it for focus traversal and eats the
        # binding before it ever reaches the app.
        Binding("1", "tab_ws", "workspaces"),
        Binding("2", "tab_sched", "schedules"),
        Binding("l", "sched_log", "log"),
        Binding("p", "toggle_preview", "preview"),
        Binding("i", "prompt", "send prompt"),
    ]

    filter_text = reactive("")

    def __init__(self, ws=None):
        super().__init__()
        self.ws = ws
        self.rows: list[Row] = []
        # Initialised here, not only in apply(): the focus event fires before
        # the first load and reached `current` with the attribute missing.
        self.shown: list[Row] = []
        self.sched_rows: list[Row] = []
        self.sched_shown: list[Row] = []
        self.err = None
        # Which schedule the user explicitly asked the log for. Without this
        # the 2s refresh redrew the card over the log a moment after `l`, so
        # the log flashed and vanished.
        self.log_for = None

    def compose(self) -> ComposeResult:
        yield Header(icon="")
        with Horizontal(id="body"):
            with Vertical(id="left"):
                # Two tabs instead of two stacked tables: they answer different
                # questions, and stacking meant the schedules were always
                # squeezed under whatever the agents tree happened to need.
                with TabbedContent(id="tabs"):
                    with TabPane("Workspaces", id="tab-ws"):
                        yield DataTable(id="table", cursor_type="row",
                                        zebra_stripes=False,
                                        show_header=False)
                    with TabPane("Schedules", id="tab-sched"):
                        yield Static("", id="sched-title")
                        yield DataTable(id="scheds", cursor_type="row",
                                        zebra_stripes=False,
                                        show_header=False)
            with Vertical(id="right"):
                with Horizontal(id="preview-head"):
                    yield Label("preview", id="preview-title")
                    yield Button("hide", id="preview-toggle")
                yield Static("", id="preview")
        yield Input(placeholder="filter…", id="filter")
        # A SEND bar, not a chat box. One line, one prompt, and the target is
        # the selected row so it can never go to the wrong agent. Following
        # the conversation still belongs in the pane, which has autocomplete,
        # file references and the agent's own modes; what this buys is not
        # having to switch windows to say "commit isso".
        yield Input(placeholder="prompt…", id="prompt")
        yield Static("", id="status")
        yield Footer()

    def on_mount(self):
        # Drop every theme but the two. `available_themes` is the source the
        # command palette reads, so unregistering is what actually removes
        # them from the picker -- setting `theme` alone would not.
        # Render with the TERMINAL's own colours, including its background.
        # Screen was already transparent, but the App composites onto a
        # derived background underneath it -- which is where the grey came
        # from. This is the switch that actually hands the palette over.
        self.ansi_color = False
        self.register_theme(ORQ_LIGHT)
        self.register_theme(ORQ_DARK)
        for name in list(self.available_themes):
            if name not in THEMES:
                self.unregister_theme(name)
        self.theme = THEMES[0]
        self.title = "orq"
        self.sub_title = self.ws or "all workspaces"
        t = self.query_one("#table", DataTable)
        # Fixed widths added up to more than the pane, so `detail` was cut and
        # the table grew a horizontal scrollbar. The last column takes what is
        # left instead.
        # Two columns, no header. Column headers turn a dashboard into a
        # spreadsheet; the shape of each field already says what it is, and the
        # labels were costing a row and a rule for nothing.
        t.add_column("", key="line")
        sc = self.query_one("#scheds", DataTable)
        sc.add_column("", key="line")
        # Without this the arrow keys never reach the table and nothing moves.
        t.focus()
        self.query_one("#preview-toggle", Button).can_focus = False
        self.first_load = True
        self.set_interval(REFRESH_S, self.reload)
        self.reload()

    # --- data ---

    @work(thread=True, exclusive=True)
    def reload(self):
        rows, err = collect(self.ws)
        sched, serr = collect_schedules()
        self.call_from_thread(self.apply, rows, err or serr)
        self.call_from_thread(self.apply_scheds, sched, serr)

    def apply_scheds(self, rows, err):
        self.sched_rows = rows
        sc = self.query_one("#scheds", DataTable)
        w = max(20, sc.size.width - 3)
        keep = sc.cursor_row
        sc.clear()
        needle = self.filter_text.lower()
        self.sched_shown = [r for r in rows
                            if not needle or needle in r.label.lower()]
        for r in self.sched_shown:
            sc.add_row(line(r.cells[0], r.cells[1], w))
        if sc.row_count:
            sc.move_cursor(row=min(keep or 0, sc.row_count - 1))
        failing = sum(1 for r in rows if r.status not in ("ok", "-"))
        alert = f" · [bold {PAL['bad']}]{failing} failing[/]" if failing else ""
        self.query_one("#sched-title", Static).update(
            f"[{PAL['muted']}]{len(rows)} timer(s)[/]{alert}")

    def apply(self, rows, err):
        self.rows, self.err = rows, err
        t = self.query_one("#table", DataTable)
        # -3: the scrollbar column plus a breathing space. A fixed floor
        # was wider than the pane on a narrow terminal and clipped the
        # right-hand annotation.
        w = max(20, t.size.width - 3)
        keep = t.cursor_row
        t.clear()
        # NOT `self.visible`: DOMNode already owns that name, with a setter
        # that validates against a set of visibility values.
        self.shown: list[Row] = []
        self.sched_rows: list[Row] = []
        self.sched_shown: list[Row] = []
        needle = self.filter_text.lower()
        for r in rows:
            if needle and needle not in r.label.lower():
                continue
            self.shown.append(r)
            t.add_row(line(r.cells[0], r.cells[1], w))
        if t.row_count:
            if getattr(self, "first_load", False):
                # Land on the first agent, not on a worktree header: the
                # preview is the point, and it should be populated on arrival.
                first = next((i for i, r in enumerate(self.shown)
                              if r.kind == "pane" and r.agent), 0)
                t.move_cursor(row=first)
                self.first_load = False
            else:
                t.move_cursor(row=min(keep, t.row_count - 1))
        self.set_status(err and f"[bold {PAL['bad']}]{err}[/]" or self.counts())
        self.refresh_preview()

    def counts(self):
        panes = [r for r in self.rows if r.kind == "pane"]
        working = sum(1 for r in panes if r.status == "working")
        scheds = sum(1 for r in self.rows if r.kind == "schedule")
        shown = f" · showing {len(self.shown)}/{len(self.rows)}" if self.filter_text else ""
        return (f"{len(panes)} pane(s) · {working} working · "
                f"{scheds} schedule(s){shown}")

    def set_status(self, text):
        self.query_one("#status", Static).update(text)

    @property
    def current(self):
        """The visible tab owns the selection, so every action reads the right
        thing with no mode to remember."""
        try:
            tabs = self.query_one("#tabs", TabbedContent)
        except Exception:
            return None
        if tabs.active == "tab-sched":
            sc = self.query_one("#scheds", DataTable)
            rows, cur = self.sched_shown, sc.cursor_row
        else:
            t = self.query_one("#table", DataTable)
            rows, cur = self.shown, t.cursor_row
        if rows and cur is not None and 0 <= cur < len(rows):
            return rows[cur]
        return None

    # --- preview: the biggest win. Look at an agent without leaving. ---

    def on_data_table_row_highlighted(self, _):
        # Drop back to the card only when the selection really MOVED. The 2s
        # refresh restores the cursor, which fires this event too -- clearing
        # unconditionally made the log revert to the card a moment after `l`.
        row = self.current
        if not row or row.kind != "schedule" or row.schedule != self.log_for:
            self.log_for = None
        self.refresh_preview()

    def on_descendant_focus(self, _):
        # Focus decides which table owns the selection, so the preview has to
        # follow the focus and not only the cursor.
        self.refresh_preview()

    def on_data_table_row_selected(self, _):
        """DataTable owns Enter -- it has its own binding for selecting a row,
        so the App-level `enter` binding never fires and the jump silently did
        nothing. Reacting to the table's own event is what actually works; the
        binding stays only so the key shows up in the footer."""
        self.action_switch()

    def refresh_preview(self):
        """A pane previews its SCREEN; a schedule previews its LAST RUN'S LOG.

        They are the same question -- what is this thing doing / what did it
        do -- and until `orq schedule log` existed there was nowhere at all to
        answer it for a schedule: the exit code says something broke and
        nothing says what.
        """
        row = self.current
        title = self.query_one("#preview-title", Label)
        body = self.query_one("#preview", Static)
        if row is None:
            title.update("preview")
            body.add_class("empty")
            body.update(f"[{PAL['muted']}]select an agent or a schedule[/]")
        elif row.kind == "pane" and row.agent:
            title.update(f"preview · {row.agent}")
            body.remove_class("empty")
            self.load_preview("read", row.agent)
        elif row.kind == "schedule" and self.log_for == row.schedule:
            title.update(f"log · {row.schedule}")
            body.remove_class("empty")
            self.load_preview("schedule-log", row.schedule)
        elif row.kind == "schedule":
            # A CARD, not the journal. Filling the screen with logs on every
            # selection is the opposite of glanceable: you look, you see
            # whether anything is wrong, and only then you dig -- `l` opens
            # the log when you actually want it.
            title.update(f"schedule · {row.schedule}")
            body.remove_class("empty")
            body.update(self.sched_card(row))
        else:
            title.update("preview")
            body.add_class("empty")
            body.update(f"[{PAL['muted']}]select an agent or a schedule[/]")

    def sched_card(self, row):
        d = row.detail or {}
        res = d.get("result") or "-"
        health = (f"[bold {PAL['bad']}]last run FAILED[/]" if res not in ("ok", "-")
                  else f"[{PAL['ok']}]last run ok[/]" if res == "ok"
                  else f"[{PAL['muted']}]has never run[/]")
        # The command is the thing you actually want to read when judging a
        # schedule -- it is what will run, unattended, with nobody watching --
        # so it gets a label and the full text instead of a dim tail.
        cmd = sched_cmd(d.get("exec")) or "?"
        lines = [
            d.get("desc") or "[bright_black]no description[/bright_black]",
            "",
            health,
            f"[bright_black]next[/bright_black]     {until(d.get('next'))}  "
            f"[bright_black]({when_short(d.get('next'))})[/bright_black]",
            f"[bright_black]last[/bright_black]     {ago(d.get('last'))}",
            f"[bright_black]when[/bright_black]     {d.get('calendar') or '?'}",
            f"[bright_black]by[/bright_black]       {d.get('creator') or '?'}",
            "",
            "[bright_black]command[/bright_black]",
            f"[{PAL['struct']}]{escape(cmd)}[/]",
        ]
        if res not in ("ok", "-"):
            lines += ["", "[bright_black]press[/bright_black] [b]l[/b] [bright_black]for the log[/bright_black]"]
        return "\n".join(lines)

    @work(thread=True, exclusive=True, group="preview")
    def load_preview(self, kind, name):
        if kind == "read":
            code, out, err = orq("read", name, "--lines", str(PREVIEW_LINES))
        else:
            code, out, err = orq("schedule", "log", name,
                                 "--lines", str(PREVIEW_LINES))
        text = out.rstrip() if code == 0 else f"[bold {PAL['bad']}]{err}[/]"
        self.call_from_thread(
            lambda: self.query_one("#preview", Static).update(text))

    # --- actions: the target comes from the selected row, never typed ---

    def action_switch(self):
        """Hands the view to the pane and STAYS RUNNING.

        `switch-client` only changes which window the client looks at, so the
        dashboard keeps living in its own window with its state intact --
        cursor, filter and all. Exiting here used to throw that away on every
        jump, which made the dashboard something you left rather than
        something you worked from.
        """
        row = self.current
        if not row or not row.target:
            self.set_status(f"[{PAL['warn']}]nothing to switch to on this row[/]")
            return
        p = subprocess.run(["tmux", "-L", "orq", "switch-client", "-t", row.target],
                           capture_output=True, text=True)
        if p.returncode:
            self.set_status(f"[bold {PAL['bad']}]{p.stderr.strip()}[/]")
        else:
            self.set_status(f"[{PAL['ok']}]→ {row.target}[/]")

    def action_sched_log(self):
        row = self.current
        if not row or row.kind != "schedule":
            return
        # Toggle: `l` again goes back to the card.
        self.log_for = None if self.log_for == row.schedule else row.schedule
        self.refresh_preview()

    def action_toggle_preview(self):
        right = self.query_one("#right")
        right.toggle_class("hidden")
        hidden = right.has_class("hidden")
        self.query_one("#preview-toggle", Button).label = "show" if hidden else "hide"

    def on_button_pressed(self, event: Button.Pressed):
        if event.button.id == "preview-toggle":
            self.action_toggle_preview()
            # Give the keyboard back: clicking a button steals focus, and the
            # arrow keys would stop moving the table.
            self.active_table.focus()

    @property
    def active_table(self):
        """The table of whichever tab is showing. Tabs replaced Tab-to-switch,
        so the selection follows the visible pane, not the focus history."""
        tabs = self.query_one("#tabs", TabbedContent)
        which = "#scheds" if tabs.active == "tab-sched" else "#table"
        return self.query_one(which, DataTable)

    # Actions that only make sense on one tab. `check_action` both hides them
    # from the footer AND disables the key, so this is not decoration: `x` on
    # the workspaces tab no longer half-works on a schedule you cannot see.
    WS_ONLY = {"switch", "kill", "wt_rm", "prompt", "resurrect"}
    SCHED_ONLY = {"sched_rm", "sched_run", "sched_log"}

    def check_action(self, action, parameters):
        try:
            on_sched = self.query_one("#tabs", TabbedContent).active == "tab-sched"
        except Exception:
            return True
        if action in self.WS_ONLY:
            return not on_sched
        if action in self.SCHED_ONLY:
            return on_sched
        # The key for the tab you are already on is dead weight in the footer.
        if action == "tab_ws":
            return on_sched
        if action == "tab_sched":
            return not on_sched
        return True

    def action_tab_ws(self):
        self.query_one("#tabs", TabbedContent).active = "tab-ws"

    def action_tab_sched(self):
        self.query_one("#tabs", TabbedContent).active = "tab-sched"

    def on_tabbed_content_tab_activated(self, _):
        self.log_for = None
        self.active_table.focus()
        self.refresh_preview()
        # Without this the footer keeps showing the old tab's keys until
        # something else happens to redraw it.
        self.refresh_bindings()

    def action_theme(self):
        self.theme = THEMES[1] if self.theme == THEMES[0] else THEMES[0]
        set_palette(dark=self.theme == "orq-dark")
        self.reload()
        self.set_status(f"theme: {self.theme}")

    def action_refresh(self):
        self.reload()

    def run_and_report(self, *args, ok=None):
        code, out, err = orq(*args)
        self.set_status(f"[bold {PAL['bad']}]{err}[/]" if code
                        else f"[{PAL['ok']}]{ok or out.strip()}[/]")
        self.reload()

    def action_kill(self):
        row = self.current
        if not row or row.kind != "pane":
            return
        if not row.agent:
            self.set_status(f"[{PAL['warn']}]that pane is not registered — "
                            f"orq only kills named agents[/]")
            return
        def go(yes):
            if yes:
                self.run_and_report("kill", row.agent, ok=f"{row.agent} killed")
        self.push_screen(
            Confirm(f"kill '{row.agent}'?\n"
                    f"the pane dies and the registry entry goes with it. "
                    f"the worktree and its branch are untouched."), go)

    def action_wt_rm(self):
        row = self.current
        if not row or row.kind != "worktree" or not row.worktree:
            return
        if row.worktree.startswith("_"):
            self.set_status(f"[{PAL['warn']}]that is not a worktree[/]")
            return
        def go(yes):
            if yes:
                self.run_and_report("wt", "rm", row.worktree, "--ws", row.ws)
        self.push_screen(
            Confirm(f"remove worktree '{row.worktree}'?\n"
                    f"the branch is never deleted, and orq refuses if it is "
                    f"dirty, unpushed, or has a live agent."), go)

    def action_sched_rm(self):
        row = self.current
        if not row or row.kind != "schedule":
            return
        def go(yes):
            if yes:
                self.run_and_report("schedule", "rm", row.schedule)
        self.push_screen(Confirm(f"remove schedule '{row.schedule}'?"), go)

    def action_sched_run(self):
        row = self.current
        if not row or row.kind != "schedule":
            return
        def go(yes):
            if yes:
                self.run_and_report("schedule", "run", row.schedule)
        self.push_screen(Confirm(f"fire '{row.schedule}' now, off schedule?"), go)

    def action_resurrect(self):
        args = ["resurrect"] + (["--ws", self.ws] if self.ws else [])
        self.run_and_report(*args)

    # --- filter ---

    def action_prompt(self):
        row = self.current
        if not row or row.kind != "pane" or not row.agent:
            self.set_status(f"[{PAL['warn']}]select an agent first[/]")
            return
        self.prompt_to = row.agent
        box = self.query_one("#prompt", Input)
        box.placeholder = f"prompt → {row.agent}"
        box.value = ""
        box.add_class("on")
        box.focus()

    def send_prompt(self, text):
        name = getattr(self, "prompt_to", None)
        box = self.query_one("#prompt", Input)
        box.remove_class("on")
        box.value = ""
        self.active_table.focus()
        if not (name and text.strip()):
            return
        code, out, err = orq("send", name, text)
        if code:
            self.set_status(f"[bold {PAL['bad']}]{err}[/]")
            return
        self.set_status(f"[{PAL['ok']}]sent to {name}[/]  "
                        f"[{PAL['faint']}]{text[:50]}[/]")
        # Show the answer coming in without being asked: the whole point of
        # sending from here is not having to go and look.
        self.log_for = None
        self.refresh_preview()

    def action_filter(self):
        f = self.query_one("#filter", Input)
        f.add_class("on")
        f.focus()

    def action_clear_filter(self):
        box = self.query_one("#prompt", Input)
        if box.has_class("on"):
            box.remove_class("on")
            box.value = ""
            self.active_table.focus()
            return
        f = self.query_one("#filter", Input)
        f.value = ""
        f.remove_class("on")
        self.filter_text = ""
        self.query_one("#table", DataTable).focus()
        self.apply(self.rows, self.err)

    def on_input_changed(self, event: Input.Changed):
        # Guarded by id: without this, typing a prompt filtered the table
        # underneath and the selected agent moved out from under the send.
        if event.input.id != "filter":
            return
        self.filter_text = event.value
        self.apply(self.rows, self.err)

    def on_input_submitted(self, event: Input.Submitted):
        if event.input.id == "prompt":
            self.send_prompt(event.value)
            return
        f = self.query_one("#filter", Input)
        f.remove_class("on")
        self.active_table.focus()


def main():
    import argparse
    p = argparse.ArgumentParser(prog="orq-dash",
                                description="Textual dashboard over orq")
    p.add_argument("ws", nargs="?", help="workspace (default: all)")
    p.add_argument("--ws", dest="ws_flag")
    a = p.parse_args()
    OrqDash(ws=a.ws_flag or a.ws).run()


if __name__ == "__main__":
    main()
